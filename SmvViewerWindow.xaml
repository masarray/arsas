<Window x:Class="ArIED61850Tester.SmvViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMV Snapshot Viewer"
        Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundGradient}"
        FontFamily="Aptos, Segoe UI Variable Text, Segoe UI, Calibri"
        Icon="Assets/app-icon.ico"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding EndpointText}" Margin="0,3,0,0" FontSize="11.5"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="9,4" CornerRadius="11"
                        Background="#EAF2FF" BorderBrush="#BDD2F4" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="SMV / IEC 61850-9-2 · 2-cycle snapshot" FontSize="11" FontWeight="SemiBold"
                               Foreground="#245EA8"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="155"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="132"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Capture adapter" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="AdapterCombo" Margin="0,4,0,0" MinHeight="31"
                                  ItemsSource="{Binding AdapterOptions}"
                                  SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  ToolTip="Select the Windows/Npcap adapter connected to the process bus or mirror port."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nominal frequency" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="FrequencyCombo" Margin="0,4,0,0" MinHeight="31" SelectedIndex="0">
                            <ComboBoxItem Content="50 Hz" Tag="50"/>
                            <ComboBoxItem Content="60 Hz" Tag="60"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="CaptureButton" Grid.Column="4" Content="Capture 2 cycles"
                            Width="132" Height="32" VerticalAlignment="Bottom"
                            Style="{StaticResource SoftButton}" Click="Capture_Click"/>
                    <Button x:Name="CancelButton" Grid.Column="6" Content="Cancel"
                            Width="78" Height="32" VerticalAlignment="Bottom" IsEnabled="False"
                            Style="{StaticResource SoftButton}" Click="Cancel_Click"/>

                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CaptureStatusText}" FontSize="10.8"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="SnapshotProgress" Height="5" Margin="0,5,0,2"
                                     Minimum="0" Maximum="1" Value="0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"/>
                            <TextBlock Text="Select the configured or discovered stream" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StreamCountText}" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="StreamGrid" Grid.Row="2"
                              ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled, ElementName=CaptureButton}"
                              SelectionChanged="P0StreamGrid_SelectionChanged"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowHeaderWidth="0" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="98"/>
                            <DataGridTextColumn Header="Control block" Binding="{Binding ControlReference}" Width="190"/>
                            <DataGridTextColumn Header="svID / smvID" Binding="{Binding StreamId}" Width="135"/>
                            <DataGridTextColumn Header="DataSet" Binding="{Binding DataSetReference}" Width="190"/>
                            <DataGridTextColumn Header="APPID" Binding="{Binding AppId}" Width="75"/>
                            <DataGridTextColumn Header="Destination MAC" Binding="{Binding DestinationMac}" Width="125"/>
                            <DataGridTextColumn Header="VLAN" Binding="{Binding Vlan}" Width="56"/>
                            <DataGridTextColumn Header="Rate" Binding="{Binding SampleRate}" Width="68"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding SampleMode}" Width="86"/>
                            <DataGridTextColumn Header="ASDU" Binding="{Binding NumberOfAsdu}" Width="58"/>
                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="66"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="4" BorderBrush="#D6E0ED" BorderThickness="1" CornerRadius="10" Background="#FBFDFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="10,8,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Static waveform proof" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Raw signed INT32 lanes are shown when channel semantics are not resolved by trusted SCL context."
                                           Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SnapshotBadgeText}" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#245EA8"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Canvas x:Name="WaveformCanvas" Height="390" MinHeight="300" Background="Transparent"
                                    SizeChanged="WaveformCanvas_SizeChanged"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#D6E0ED" BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SnapshotSummaryText}" FontSize="11.2" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SnapshotEvidenceText}" Margin="0,4,0,0" FontSize="10.4"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SnapshotContinuityEvidenceText}" Margin="0,3,0,0" FontSize="10.4"
                                       Foreground="#8A4B08" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SnapshotBoundaryText}" Margin="0,4,0,0" FontSize="10.1"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Column="2" ItemsSource="{Binding SnapshotChannels}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="#D6E0ED" BorderThickness="1" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raw lane" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinimumText}" Width="80"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaximumText}" Width="80"/>
                            <DataGridTextColumn Header="Pk–Pk" Binding="{Binding PeakToPeakText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedStreamDetail}" Margin="0,3,0,0" FontSize="10.8"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EvidenceExportStatusText}" Margin="0,3,0,0" FontSize="10.4"
                               Foreground="#245EA8" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="ExportEvidenceButton" Grid.Column="1" Content="Export evidence"
                        Width="128" Margin="12,0,0,0" Click="ExportEvidence_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SnapshotChannels.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled, ElementName=CancelButton}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEvidenceExportBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="2" Content="Close" Width="82" Margin="8,0,0,0"
                        Style="{StaticResource SoftButton}" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>