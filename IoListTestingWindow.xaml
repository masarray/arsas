<Window x:Class="ArIED61850Tester.IoListTestingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:io="clr-namespace:ArIED61850Tester.Models.IoTesting"
        Title="ARSAS - IO List Testing"
        Height="900" Width="1500" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{StaticResource AppBackgroundGradient}"
        FontFamily="Aptos, Segoe UI Variable Text, Segoe UI, Calibri"
        Icon="Assets/app-icon.ico" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FatGridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12.2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8EDF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#617087"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DCE4EF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7F9FC"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F2F6FC"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IO LIST FAT" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding Project.ProjectName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,2,0,0"/>
                    <TextBlock Text="Workbook scope · report-first acquisition · relay-timestamped evidence" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#F1F5FB" CornerRadius="14" Padding="12,7" Margin="0,0,9,0"><TextBlock Text="{Binding ProjectSummary}" FontSize="11.8" Foreground="{StaticResource Ink}"/></Border>
                    <Button Content="Save" Style="{StaticResource SoftButton}" Padding="11,7" Click="SaveProgress_Click" Margin="0,0,6,0"/>
                    <Button Content="Excel" Style="{StaticResource SoftButton}" Padding="11,7" Click="ExportExcel_Click" Margin="0,0,6,0"/>
                    <Button Content="PDF" Style="{StaticResource SoftButton}" Padding="11,7" Click="ExportPdf_Click" Margin="0,0,6,0"/>
                    <Button Content="Export .arsas" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="ExportHandover_Click" Margin="0,0,6,0"/>
                    <Button Content="Engineering" Style="{StaticResource SoftButton}" Padding="11,7" Click="ReturnToEngineering_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="304"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="5,3,5,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="IED EXPLORER" Style="{StaticResource MicroLabel}"/><TextBlock Text="Workbook devices" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
                        <Border Grid.Column="1" Background="#F1F5FB" CornerRadius="12" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Project.Ieds.Count}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Ink}"/></Border>
                    </Grid>
                    <ListBox ItemsSource="{Binding Project.Ieds}" SelectedItem="{Binding SelectedIed, Mode=TwoWay}" IsEnabled="{Binding CanSelectIed}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="IedCard" Background="#FAFCFF" BorderBrush="#D8E1EE" BorderThickness="1" CornerRadius="15" Padding="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IedCard" Property="Background" Value="#F5F8FD"/><Setter TargetName="IedCard" Property="BorderBrush" Value="#AFC4E6"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="IedCard" Property="Background" Value="#EDF4FF"/><Setter TargetName="IedCard" Property="BorderBrush" Value="#6F9FF1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="66">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="RelayIcon" Data="M 2 0 L 2 20 L 18 20 L 18 0 L 2 0 z M 3 1 L 17 1 L 17 19 L 3 19 L 3 1 z M 5 3 L 5 7 L 15 7 L 15 3 L 5 3 z M 6 4 L 14 4 L 14 6 L 6 6 L 6 4 z M 5 10 L 5 11 L 7 11 L 7 10 L 5 10 z M 9 10 L 9 11 L 11 11 L 11 10 L 9 10 z M 13 10 L 13 11 L 15 11 L 15 10 L 13 10 z M 5 13 L 5 14 L 7 14 L 7 13 L 5 13 z M 9 13 L 9 14 L 11 14 L 11 13 L 9 13 z M 13 13 L 13 14 L 15 14 L 15 13 L 13 13 z M 5 16 L 5 17 L 7 17 L 7 16 L 5 16 z M 9 16 L 9 17 L 11 17 L 11 16 L 9 16 z M 13 16 L 13 17 L 15 17 L 15 16 L 13 16 z" Fill="#D94B55" Stretch="Uniform"/>
                                    </Viewbox>
                                    <Grid Grid.Column="1" Margin="3,0,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IedName}" FontSize="12.8" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StateText" Grid.Column="1" Text="{Binding CardStateText}" FontSize="8.5" FontWeight="Bold" Foreground="#C53A45" VerticalAlignment="Center"/></Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding IpAddress}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="10.5" Foreground="{StaticResource Muted}"><Run Text="{Binding BoundCount, Mode=OneWay}"/><Run Text=" live  ·  "/><Run Text="{Binding PassedCount, Mode=OneWay}"/><Run Text=" pass  ·  "/><Run Text="{Binding PendingCount, Mode=OneWay}"/><Run Text=" pending"/></TextBlock>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveConnected}" Value="True"><Setter TargetName="RelayIcon" Property="Fill" Value="#D49A26"/><Setter TargetName="StateText" Property="Foreground" Value="#A56D00"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveMonitoring}" Value="True"><Setter TargetName="RelayIcon" Property="Fill" Value="#18A66A"/><Setter TargetName="StateText" Property="Foreground" Value="#16845A"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsPreparing}" Value="True"><Setter TargetName="RelayIcon" Property="Fill" Value="#4F7FEA"/><Setter TargetName="StateText" Property="Foreground" Value="#315DBF"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedIed.IedName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding SelectedIedSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Session.StateText}" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Content="{Binding StartWorkflowText}" Style="{StaticResource PrimaryButton}" Padding="13,8" IsEnabled="{Binding CanStartWorkflow}" Click="StartSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Pause" Style="{StaticResource SoftButton}" Padding="11,8" IsEnabled="{Binding Session.CanPause}" Click="PauseSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Resume" Style="{StaticResource SoftButton}" Padding="11,8" IsEnabled="{Binding Session.CanResume}" Click="ResumeSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Stop" Style="{StaticResource SoftButton}" Padding="11,8" IsEnabled="{Binding Session.CanStop}" Click="StopSession_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Visibility="{Binding PreparationVisibility}" Margin="0,11,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PreparationIedText}" FontSize="11.6" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding PreparationStatusText}" FontSize="10.8" Foreground="#526783" TextTrimming="CharacterEllipsis"/></Grid>
                        <ProgressBar Grid.Row="1" Height="3" Margin="0,7,0,0" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#E8EEF8" BorderThickness="0"/>
                    </Grid>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedIed.TestPoints}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="1" BorderBrush="#E1E7F0" Background="White" RowBackground="White" AlternatingRowBackground="White" HorizontalGridLinesBrush="#E8EDF5" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="TEST" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEditPlan, RelativeSource={RelativeSource AncestorType=DataGrid}}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SIGNAL" Width="2.0*" MinWidth="205"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SignalName}" Style="{StaticResource FatGridText}" FontWeight="SemiBold" ToolTip="{Binding SignalName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="IEC REFERENCE" Width="2.35*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ObjectReference}" Style="{StaticResource FatGridText}" FontFamily="Cascadia Mono, Consolas" FontSize="11.2" Foreground="#52627A" ToolTip="{Binding ObjectReference}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LIVE" Width="78"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LiveBindingText}" FontSize="10.8" FontWeight="SemiBold" Foreground="#5C6C82" VerticalAlignment="Center" ToolTip="{Binding LiveBindingReason}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VALUE" Width="88"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Runtime.CurrentValue}" Style="{StaticResource FatGridText}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="QUALITY" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Runtime.CurrentQuality}" Style="{StaticResource FatGridText}" FontSize="11.2" ToolTip="{Binding Runtime.CurrentQuality}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACQUISITION" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Runtime.CurrentSource}" FontSize="10.8" FontWeight="SemiBold" Foreground="#405B7D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Runtime.CurrentSource}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ON · RELAY TIME" Width="164"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Runtime.OnRelayTimestampText}" Style="{StaticResource FatGridText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.8" ToolTip="{Binding Runtime.OnEvidenceToolTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OFF · RELAY TIME" Width="164"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Runtime.OffRelayTimestampText}" Style="{StaticResource FatGridText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.8" ToolTip="{Binding Runtime.OffEvidenceToolTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RESULT" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="ResultText" Text="{Binding Runtime.StateText}" FontSize="10.8" FontWeight="SemiBold" Foreground="#607089" VerticalAlignment="Center" ToolTip="{Binding Runtime.StatusReason}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Runtime.State}" Value="{x:Static io:IoTestPointState.Passed}"><Setter TargetName="ResultText" Property="Text" Value="✔ PASS"/><Setter TargetName="ResultText" Property="Foreground" Value="#16845A"/><Setter TargetName="ResultText" Property="FontWeight" Value="Bold"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Runtime.State}" Value="{x:Static io:IoTestPointState.Review}"><Setter TargetName="ResultText" Property="Text" Value="REVIEW"/><Setter TargetName="ResultText" Property="Foreground" Value="#9A6500"/><Setter TargetName="ResultText" Property="FontWeight" Value="Bold"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Runtime.State}" Value="{x:Static io:IoTestPointState.Failed}"><Setter TargetName="ResultText" Property="Text" Value="✖ FAILED"/><Setter TargetName="ResultText" Property="Foreground" Value="#C53A45"/><Setter TargetName="ResultText" Property="FontWeight" Value="Bold"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Runtime.State}" Value="{x:Static io:IoTestPointState.ArmedForOn}"><Setter TargetName="ResultText" Property="Foreground" Value="#315DBF"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#F8FAFD" BorderBrush="#DEE6F0" BorderThickness="1" CornerRadius="13" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.0*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FooterStatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="{Binding Session.JournalPath}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Storage.LastSavedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding Storage.SnapshotPath}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Session.ProgressText}" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Ink}"/><TextBlock Text="  ·  " Style="{StaticResource Caption}"/><TextBlock Style="{StaticResource Caption}"><Run Text="Evidence "/><Run Text="{Binding Session.EvidenceRecordCount, Mode=OneWay}"/></TextBlock></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
