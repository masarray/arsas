<Window x:Class="ArIED61850Tester.IoListTestingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARSAS - IO List Testing"
        Height="900" Width="1500" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{StaticResource AppBackgroundGradient}"
        FontFamily="Aptos, Segoe UI Variable Text, Segoe UI, Calibri"
        Icon="Assets/app-icon.ico" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="IO LIST TESTING" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding Project.ProjectName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Workbook-driven connect · configured-report-first monitoring · read-only OFF → ON → OFF evidence"
                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{StaticResource SoftBlue}" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ProjectSummary}" FontSize="12" Foreground="{StaticResource Ink}"/>
                    </Border>
                    <Button Content="Save Progress" Style="{StaticResource SoftButton}" Padding="11,7"
                            Click="SaveProgress_Click" Margin="0,0,6,0"/>
                    <Button Content="Export Excel" Style="{StaticResource SoftButton}" Padding="11,7"
                            Click="ExportExcel_Click" Margin="0,0,6,0"/>
                    <Button Content="Export PDF" Style="{StaticResource SoftButton}" Padding="11,7"
                            Click="ExportPdf_Click" Margin="0,0,6,0"/>
                    <Button Content="Export .arsas" Style="{StaticResource PrimaryButton}" Padding="11,7"
                            Click="ExportHandover_Click" Margin="0,0,6,0"/>
                    <Button Content="Return to Engineering" Style="{StaticResource SoftButton}" Click="ReturnToEngineering_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                        <TextBlock Text="IED TEST PLAN" Style="{StaticResource MicroLabel}"/>
                        <TextBlock Text="Only IEDs imported from the workbook" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Project.Ieds}" SelectedItem="{Binding SelectedIed, Mode=TwoWay}"
                             IsEnabled="{Binding CanSelectIed}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="IedCard" Background="{StaticResource IedCardSurface}"
                                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                    CornerRadius="14" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IedCard" Property="Background" Value="{StaticResource IedCardHover}"/>
                                                    <Setter TargetName="IedCard" Property="BorderBrush" Value="#8EAFE3"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="IedCard" Property="Background" Value="{StaticResource IedCardSelected}"/>
                                                    <Setter TargetName="IedCard" Property="BorderBrush" Value="#4F86E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding IedName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding IpAddress}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding IedRole}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="11.3" Foreground="{StaticResource Muted}">
                                        <Run Text="{Binding BoundCount, Mode=OneWay}"/><Run Text=" bound · "/>
                                        <Run Text="{Binding PassedCount, Mode=OneWay}"/><Run Text=" passed · "/>
                                        <Run Text="{Binding PendingCount, Mode=OneWay}"/><Run Text=" pending"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedIed.IedName}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding SelectedIedSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Session.ActiveIedText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PreparationStatusText}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Accent}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource SoftBlue}" CornerRadius="13" Padding="11,6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Session.StateText}" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <Button Content="{Binding StartWorkflowText}" Style="{StaticResource PrimaryButton}" Padding="12,7"
                                    IsEnabled="{Binding CanStartWorkflow}" Click="StartSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Pause" Style="{StaticResource SoftButton}" Padding="11,7"
                                    IsEnabled="{Binding Session.CanPause}" Click="PauseSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Resume" Style="{StaticResource SoftButton}" Padding="11,7"
                                    IsEnabled="{Binding Session.CanResume}" Click="ResumeSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Stop" Style="{StaticResource SoftButton}" Padding="11,7"
                                    IsEnabled="{Binding Session.CanStop}" Click="StopSession_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedIed.TestPoints}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent" RowBackground="White"
                              AlternatingRowBackground="#F8FAFD" HorizontalGridLinesBrush="{StaticResource BorderSubtle}"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Test" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.CanEditPlan, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Signal name" Binding="{Binding SignalName}" IsReadOnly="True" Width="2.1*"/>
                            <DataGridTextColumn Header="IEC reference" Binding="{Binding ObjectReference}" IsReadOnly="True" Width="2.4*"/>
                            <DataGridTextColumn Header="Live binding" Binding="{Binding LiveBindingText}" IsReadOnly="True" Width="112"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Runtime.CurrentValue}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Quality" Binding="{Binding Runtime.CurrentQuality}" IsReadOnly="True" Width="96"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Runtime.CurrentSource}" IsReadOnly="True" Width="104"/>
                            <DataGridTextColumn Header="ON evidence" Binding="{Binding Runtime.OnEvidence.CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" IsReadOnly="True" Width="178"/>
                            <DataGridTextColumn Header="OFF evidence" Binding="{Binding Runtime.OffEvidence.CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" IsReadOnly="True" Width="178"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Runtime.State}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#F7FAFF" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Session.StatusText}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Session.JournalIntegrityText}" Style="{StaticResource MicroLabel}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Session.JournalPath}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.JournalPath}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Storage.StatusText}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Storage.LastSavedText}" Style="{StaticResource MicroLabel}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Storage.SnapshotPath}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Storage.SnapshotPath}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Session.ProgressText}" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <Run Text="Evidence records "/><Run Text="{Binding Session.EvidenceRecordCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Autosave enabled" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
