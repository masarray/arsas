<Window x:Class="ArIED61850Tester.IoListTestingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:io="clr-namespace:ArIED61850Tester.Models.IoTesting"
        xmlns:local="clr-namespace:ArIED61850Tester"
        Title="ARSAS - IO List Testing"
        Height="900" Width="1500" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{StaticResource AppBackgroundGradient}"
        FontFamily="Aptos, Segoe UI Variable Text, Segoe UI, Calibri"
        Icon="Assets/app-icon.ico"
        Closing="Window_Closing"
        ContentRendered="IoListTestingWindow_ContentRendered">
    <Window.Resources>
        <local:IoFatAllPassedVisibilityConverter x:Key="AllPassedVisibilityConverter"/>
        <!-- Lucide-compatible 24px vector paths: crisp at field-laptop DPI without bitmap assets. -->
        <Geometry x:Key="LucideSave">M19,21H5A2,2 0 0 1 3,19V5A2,2 0 0 1 5,3H16L21,8V19A2,2 0 0 1 19,21M17,21V13H7V21M7,3V8H15</Geometry>
        <Geometry x:Key="LucideSheet">M4,3H20V21H4Z M4,9H20 M4,15H20 M10,9V21</Geometry>
        <Geometry x:Key="LucideFileText">M14,2H6A2,2 0 0 0 4,4V20A2,2 0 0 0 6,22H18A2,2 0 0 0 20,20V8Z M14,2V8H20 M8,13H16 M8,17H16</Geometry>
        <Geometry x:Key="LucidePackageUp">M16.5,9.4L7.5,4.2 M21,16V8A2,2 0 0 0 20,6.3L13,2.3A2,2 0 0 0 11,2.3L4,6.3A2,2 0 0 0 3,8V16A2,2 0 0 0 4,17.7L11,21.7A2,2 0 0 0 13,21.7L20,17.7A2,2 0 0 0 21,16 M3.3,7L12,12L20.7,7 M12,22V12 M12,7V2</Geometry>
        <Geometry x:Key="LucideWrench">M14.7,6.3A4,4 0 0 0 9.4,11.6L3.5,17.5A2.1,2.1 0 0 0 6.5,20.5L12.4,14.6A4,4 0 0 0 17.7,9.3L15,12L12,9L14.7,6.3Z</Geometry>
        <Geometry x:Key="LucidePrinter">M6,9V2H18V9 M6,18H4A2,2 0 0 1 2,16V11A2,2 0 0 1 4,9H20A2,2 0 0 1 22,11V16A2,2 0 0 1 20,18H18 M6,14H18V22H6Z M18,12H18.01</Geometry>
        <Geometry x:Key="LucidePlay">M6,3L20,12L6,21Z</Geometry>
        <Geometry x:Key="LucidePause">M8,5V19 M16,5V19</Geometry>
        <Geometry x:Key="LucideStop">M6,6H18V18H6Z</Geometry>
        <Geometry x:Key="LucideCheckCircle">M22,11.1V12A10,10 0 1 1 16.1,2.9 M22,4L12,14L9,11</Geometry>
        <Geometry x:Key="LucideAlertCircle">M12,22A10,10 0 1 0 12,2A10,10 0 0 0 12,22 M12,8V12 M12,16H12.01</Geometry>

        <Style x:Key="FatToolbarButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C7D4E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        </Style>
        <Style x:Key="FatPrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FatStopToolbarButton" TargetType="Button" BasedOn="{StaticResource FatToolbarButton}">
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="Background" Value="#FFF8F7"/>
            <Setter Property="BorderBrush" Value="#F2B8B5"/>
        </Style>

        <Style x:Key="FatGridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12.2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8EDF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#617087"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DCE4EF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CenteredFatGridHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F8FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IO LIST FAT" Style="{StaticResource MicroLabel}" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding Project.ProjectName}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="0,2,0,0"/>
                    <TextBlock Text="Workbook scope · report-first acquisition · relay-timestamped evidence"
                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#F1F5FB" CornerRadius="14" Padding="12,7" Margin="0,0,9,0">
                        <TextBlock Text="{Binding ProjectSummary}" FontSize="11.8" Foreground="{StaticResource Ink}"/>
                    </Border>
                    <Button Style="{StaticResource FatToolbarButton}" Click="SaveProgress_Click" Margin="0,0,6,0" ToolTip="Save FAT progress">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucideSave}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Save"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FatToolbarButton}" Click="ExportExcel_Click" Margin="0,0,6,0" ToolTip="Export Excel result workbook">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucideSheet}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Excel"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FatToolbarButton}"
                            ToolTip="Fresh untested scope exports a blank IFAT form; recorded test activity exports a FAT test record."
                            Click="ExportPdf_Click" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucideFileText}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="PDF Form / Report"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FatPrimaryToolbarButton}" Click="ExportHandover_Click" Margin="0,0,6,0" ToolTip="Export portable ARSAS handover package">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucidePackageUp}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Export .arsas"/></StackPanel>
                    </Button>
                    <Button x:Name="EngineeringButton" Style="{StaticResource FatToolbarButton}" Click="ReturnToEngineering_Click" ToolTip="Return to the Engineering workspace">
                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucideWrench}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Engineering"/></StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="5,3,5,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IED EXPLORER" Style="{StaticResource MicroLabel}"/>
                            <TextBlock Text="Workbook devices" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F1F5FB" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Project.Ieds.Count}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource Ink}"/>
                        </Border>
                    </Grid>

                    <ListBox ItemsSource="{Binding Project.Ieds}"
                             SelectedItem="{Binding SelectedIed, Mode=TwoWay}"
                             IsEnabled="{Binding CanSelectIed}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="IedCard" Background="#FAFCFF" BorderBrush="#D8E1EE"
                                                    BorderThickness="1" CornerRadius="15" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IedCard" Property="Background" Value="#F5F8FD"/>
                                                    <Setter TargetName="IedCard" Property="BorderBrush" Value="#AFC4E6"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="IedCard" Property="Background" Value="#EDF4FF"/>
                                                    <Setter TargetName="IedCard" Property="BorderBrush" Value="#6F9FF1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="70">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Control x:Name="RelayIcon" Width="50" Height="50" Foreground="#D94B55"
                                                 Template="{StaticResource IedRelayFrontPanelTemplate}"/>
                                    </Viewbox>
                                    <Grid Grid.Column="1" Margin="3,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IedName}" FontSize="12.8" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border x:Name="StateBadge" Background="#FFF1F2"
                                                        BorderBrush="#F0B7BC" BorderThickness="1" CornerRadius="9" Padding="7,2">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllPassedVisibilityConverter}" ConverterParameter="Inverse">
                                                            <Binding Path="TestPoints.Count"/>
                                                            <Binding Path="PassedCount"/>
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                    <TextBlock x:Name="StateText" Text="{Binding CardStateText}"
                                                               FontSize="8.5" FontWeight="Bold" Foreground="#C53A45"/>
                                                </Border>
                                                <Border Background="#EAF8F1" BorderBrush="#8FD1B1"
                                                        BorderThickness="1" CornerRadius="9" Padding="7,2">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllPassedVisibilityConverter}">
                                                            <Binding Path="TestPoints.Count"/>
                                                            <Binding Path="PassedCount"/>
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                    <TextBlock Text="✔ PASS" FontSize="8.5" FontWeight="Bold" Foreground="#16845A"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding IpAddress}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="10.5"
                                                   Foreground="{StaticResource Muted}">
                                            <Run Text="{Binding BoundCount, Mode=OneWay}"/>
                                            <Run Text=" live  ·  "/>
                                            <Run Text="{Binding PassedCount, Mode=OneWay}"/>
                                            <Run Text=" pass  ·  "/>
                                            <Run Text="{Binding PendingCount, Mode=OneWay}"/>
                                            <Run Text=" pending"/>
                                        </TextBlock>
                                        <ProgressBar x:Name="CardProgress"
                                                     Grid.Row="3"
                                                     Height="3"
                                                     Margin="0,8,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     IsIndeterminate="True"
                                                     Visibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="#DCE7F8"
                                                     Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveConnected}" Value="True">
                                        <Setter TargetName="RelayIcon" Property="Foreground" Value="#D49A26"/>
                                        <Setter TargetName="StateBadge" Property="Background" Value="#FFF8E8"/>
                                        <Setter TargetName="StateBadge" Property="BorderBrush" Value="#E9C46A"/>
                                        <Setter TargetName="StateText" Property="Foreground" Value="#A56D00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveMonitoring}" Value="True">
                                        <Setter TargetName="RelayIcon" Property="Foreground" Value="#18A66A"/>
                                        <Setter TargetName="StateBadge" Property="Background" Value="#EAF8F1"/>
                                        <Setter TargetName="StateBadge" Property="BorderBrush" Value="#8FD1B1"/>
                                        <Setter TargetName="StateText" Property="Foreground" Value="#16845A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPreparing}" Value="True">
                                        <Setter TargetName="RelayIcon" Property="Foreground" Value="#4F7FEA"/>
                                        <Setter TargetName="CardProgress" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="StateBadge" Property="Background" Value="#EDF3FF"/>
                                        <Setter TargetName="StateBadge" Property="BorderBrush" Value="#9CB8F5"/>
                                        <Setter TargetName="StateText" Property="Foreground" Value="#315DBF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding SelectedIed.IedName}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding SelectedIedSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="WorkspacePreviewToggle"
                                    Style="{StaticResource FatToolbarButton}"
                                    Click="TogglePrintPreview_Click"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucidePrinter}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock x:Name="WorkspacePreviewText" Text="Print Preview"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FatPrimaryToolbarButton}" IsEnabled="{Binding SelectedCanStartWorkflow}"
                                    Click="StartSelectedIedSafely_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucidePlay}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="{Binding SelectedStartWorkflowText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FatToolbarButton}" IsEnabled="{Binding SelectedCanPause}" Click="PauseSession_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucidePause}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Pause"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FatToolbarButton}" IsEnabled="{Binding SelectedCanResume}" Click="ResumeSession_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucidePlay}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Resume"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FatStopToolbarButton}" IsEnabled="{Binding SelectedCanStop}" Click="StopSession_Click">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource LucideStop}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Text="Stop"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Visibility="{Binding PreparationVisibility}"
                            Background="#F3F7FF" BorderBrush="#B9CCF4" BorderThickness="1"
                            CornerRadius="13" Padding="12,9" Margin="0,11,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PreparationIedText}" FontSize="11.8" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PreparationStatusText}" FontSize="10.8"
                                           Foreground="#526783" Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <ProgressBar Height="4"
                                         Margin="0,9,0,0"
                                         IsIndeterminate="True"
                                         BorderThickness="0"
                                         Background="#DCE7F8"
                                         Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding SelectedIed.TestPoints}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="1"
                              BorderBrush="#E1E7F0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="White"
                              HorizontalGridLinesBrush="#E8EDF5"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              FrozenColumnCount="1"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="TEST" Width="48" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.CanEditPlan, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SIGNAL" Width="1.55*" MinWidth="190" MaxWidth="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SignalName}" Style="{StaticResource FatGridText}"
                                                   FontWeight="SemiBold" ToolTip="{Binding SignalName}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="IEC REFERENCE" Width="1.85*" MinWidth="235" MaxWidth="360">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ObjectReference}" Style="{StaticResource FatGridText}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.0"
                                                   Foreground="#52627A" ToolTip="{Binding ObjectReference}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LIVE" Width="82" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="LiveText" Text="{Binding LiveBindingText}"
                                                   Style="{StaticResource FatGridText}" FontSize="10.8"
                                                   FontWeight="SemiBold" Foreground="#65758B"
                                                   ToolTip="{Binding LiveBindingDiagnostics}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveBound}" Value="True">
                                                <Setter TargetName="LiveText" Property="Foreground" Value="#16845A"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VALUE" Width="78" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.CurrentValue}" Style="{StaticResource FatGridText}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="QUALITY" Width="88" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.CurrentQuality}" Style="{StaticResource FatGridText}"
                                                   FontSize="11.2" ToolTip="{Binding Runtime.CurrentQuality}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACQUISITION" Width="136" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.CurrentSource}" Style="{StaticResource FatGridText}"
                                                   FontSize="10.8" FontWeight="SemiBold" Foreground="#405B7D"
                                                   ToolTip="{Binding Runtime.CurrentSource}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ON · RELAY TIME" Width="168"
                                                    HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.OnRelayTimestampText}"
                                                   Style="{StaticResource FatGridText}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="10.4"
                                                   ToolTip="{Binding Runtime.OnEvidenceToolTip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OFF · RELAY TIME" Width="168"
                                                    HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.OffRelayTimestampText}"
                                                   Style="{StaticResource FatGridText}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="10.4"
                                                   ToolTip="{Binding Runtime.OffEvidenceToolTip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="118" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Runtime.StateText}" Style="{StaticResource FatGridText}"
                                                   FontSize="10.7" FontWeight="SemiBold" Foreground="#607089"
                                                   ToolTip="{Binding Runtime.StatusReason}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RESULT" Width="92" HeaderStyle="{StaticResource CenteredFatGridHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="FinalResultText" Text="—"
                                                   Style="{StaticResource FatGridText}"
                                                   FontSize="10.8" FontWeight="Bold"
                                                   Foreground="#8A97A9"
                                                   ToolTip="{Binding Runtime.StatusReason}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Runtime.State}"
                                                         Value="{x:Static io:IoTestPointState.Passed}">
                                                <Setter TargetName="FinalResultText" Property="Text" Value="✔ PASS"/>
                                                <Setter TargetName="FinalResultText" Property="Foreground" Value="#16845A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Runtime.State}"
                                                         Value="{x:Static io:IoTestPointState.Review}">
                                                <Setter TargetName="FinalResultText" Property="Text" Value="⚠ REVIEW"/>
                                                <Setter TargetName="FinalResultText" Property="Foreground" Value="#9A6500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Runtime.State}"
                                                         Value="{x:Static io:IoTestPointState.Failed}">
                                                <Setter TargetName="FinalResultText" Property="Text" Value="✖ FAILED"/>
                                                <Setter TargetName="FinalResultText" Property="Foreground" Value="#C53A45"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#F8FAFD" BorderBrush="#DEE6F0"
                BorderThickness="1" CornerRadius="13" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedFooterStatusText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" ToolTip="{Binding Session.JournalPath}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Storage.LastSavedText}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" ToolTip="{Binding Storage.SnapshotPath}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedProgressText}" Style="{StaticResource MicroLabel}"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}"/>
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="Evidence "/>
                        <Run Text="{Binding SelectedEvidenceCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FailureShout"
                Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="520" MaxWidth="720" Margin="0,58,18,0"
                Background="#FFFFFF" BorderBrush="#F1B6B2" BorderThickness="1"
                CornerRadius="12" Padding="0" Visibility="Collapsed" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.22" Color="#3D526F"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#D92D20" CornerRadius="11,0,0,11"/>
                <Viewbox Grid.Column="1" Width="20" Height="20" Margin="15,14,11,14" VerticalAlignment="Top">
                    <Path Data="{StaticResource LucideAlertCircle}" Stroke="#D92D20" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                </Viewbox>
                <StackPanel Grid.Column="2" Margin="0,11,16,12">
                    <TextBlock x:Name="FailureShoutTitle" FontSize="12.5" FontWeight="Bold" Foreground="#8A1C15"/>
                    <TextBlock x:Name="FailureShoutMessage" Margin="0,3,0,0" FontSize="11.5" Foreground="#4C5668"
                               TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
