<Window x:Class="ArIED61850Tester.BrowserDataWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Data to IED" Width="540" Height="315"
        MinWidth="480" MinHeight="295" MaxHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F9FC" FontFamily="{StaticResource AppFontFamily}" FontSize="11.5"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="15,13,15,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ReferenceLabel" Grid.Row="0" Margin="2,0,2,10"
                   Foreground="#2A435F" FontFamily="{StaticResource AppCodeFontFamily}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8E1EC"
                BorderThickness="1" CornerRadius="7" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="#E9EEF5" Height="29">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Margin="9,0" VerticalAlignment="Center" Foreground="#52667B"/>
                    <TextBlock Grid.Column="1" Text="Value" Margin="9,0" VerticalAlignment="Center" Foreground="#52667B"/>
                </Grid>
                <Grid Grid.Row="1" Height="37" Background="#F5F8FC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="DA" Foreground="#226EB9" FontWeight="SemiBold" Margin="0,0,7,0"/>
                        <TextBlock x:Name="AttributeLabel" Text="Value" Foreground="#293D54" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TypeLabel" Foreground="#76879B" FontSize="10" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="4,3,5,3">
                        <ComboBox x:Name="BoolPicker" Visibility="Collapsed" Height="29"
                                  SelectionChanged="BoolPicker_SelectionChanged" IsEnabled="False">
                            <ComboBoxItem Content="true" Tag="true"/>
                            <ComboBoxItem Content="false" Tag="false"/>
                        </ComboBox>
                        <TextBox x:Name="NewValueBox" Height="29" Padding="7,4"
                                 IsEnabled="False" VerticalContentAlignment="Center"
                                 TextChanged="NewValueBox_TextChanged"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="2" Margin="8,10,8,2">
                    <TextBlock x:Name="CurrentLabel" Text="Reading IED…" Foreground="#597087" FontSize="10.5"/>
                    <TextBlock x:Name="DiffLabel" Text="" Foreground="#55738D"
                               TextWrapping="Wrap" FontSize="10.5" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Text="Reading live MMS type…"
                       Foreground="#61758A" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" FontSize="10.5" Margin="0,0,9,0"/>
            <Button x:Name="WriteButton" Grid.Column="1" Content="Write"
                    Width="94" Height="31" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Click="Write_Click" Margin="0,0,7,0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource MaterialEditIcon}" Fill="White"/>
                            </Viewbox>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Button Grid.Column="2" Content="Cancel" Width="84" Height="31"
                    Style="{StaticResource SoftButton}"
                    ContentTemplate="{StaticResource MaterialCancelAction}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
