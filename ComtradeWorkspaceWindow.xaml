<Window x:Class="ArIED61850Tester.ComtradeWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArIED61850Tester.Controls"
        Title="ARSAS — COMTRADE Workspace"
        Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9E3EF" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="COMTRADE Workspace" FontSize="17" FontWeight="SemiBold" Foreground="#18324F"/>
                        <TextBlock x:Name="RecordIdentityText" Margin="14,2,0,0" FontSize="10.5" Foreground="#6A7F98" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EEF6FF" BorderBrush="#C8DEF8" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#2A78DF" VerticalAlignment="Center"/>
                            <TextBlock Text="Native ArdIrec core" Margin="6,0,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="#275D9A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Station / recorder" FontSize="9.5" Foreground="#8997A9"/>
                        <TextBlock x:Name="StationText" Margin="0,1,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#263D58" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Channels" FontSize="9.5" Foreground="#8997A9"/>
                        <TextBlock x:Name="ChannelsText" Margin="0,1,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#263D58"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="Nominal frequency" FontSize="9.5" Foreground="#8997A9"/>
                        <TextBlock x:Name="FrequencyText" Margin="0,1,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#263D58"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="16,0,0,0">
                        <TextBlock Text="Frames" FontSize="9.5" Foreground="#8997A9"/>
                        <TextBlock x:Name="FramesText" Margin="0,1,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#263D58"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D9E3EF" BorderThickness="1" CornerRadius="9" Padding="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Signals" FontSize="12.5" FontWeight="SemiBold" Foreground="#263D58"/>
                            <TextBlock x:Name="SignalCountText" Margin="7,1,0,0" FontSize="9.5" Foreground="#7B8CA2"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Auto" Height="24" Padding="9,0" Margin="5,0,0,0" FontSize="9.5" Cursor="Hand" Click="AutoSignals_Click" ToolTip="Show a practical starter set of analog phases and protection/status channels."/>
                        <Button Grid.Column="3" Content="Clear" Height="24" Padding="9,0" Margin="5,0,0,0" FontSize="9.5" Cursor="Hand" Click="ClearSignals_Click" ToolTip="Hide all waveform tracks."/>
                    </Grid>

                    <ListBox x:Name="SignalList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             SelectionChanged="SignalList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Loaded="SignalVisibility_Loaded"
                                              Checked="SignalVisibility_Checked"
                                              Unchecked="SignalVisibility_Unchecked"
                                              ToolTip="Show or hide this signal in the synchronized waveform workspace."/>
                                    <Border Grid.Column="2" Width="4" Height="27" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#263D58" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,1,0,0" FontSize="9.2" Foreground="#8190A3" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D9E3EF" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFD" BorderBrush="#E1E8F1" BorderThickness="0,0,0,1" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="WaveformModeButton" Content="Waveform" Height="27" MinWidth="82" Padding="12,0"
                                        FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="WaveformMode_Click"/>
                                <Button x:Name="PhasorModeButton" Content="Phasor" Height="27" MinWidth="72" Margin="5,0,0,0" Padding="12,0"
                                        FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="PhasorMode_Click"/>
                                <Button x:Name="HarmonicsModeButton" Content="Harmonics" Height="27" MinWidth="86" Margin="5,0,0,0" Padding="12,0"
                                        FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="HarmonicsMode_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AnalysisReferenceTextBlock" Grid.Column="2" Text="Analysis reference: Cursor A / viewport"
                                       FontSize="9.6" Foreground="#7A8BA0" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavigationTextBlock"
                                       Text="Shared timeline • trigger = 0 ms • click Cursor A • Ctrl/right-click Cursor B • digital ↑/↓ = transition"
                                       FontSize="10" Foreground="#64778F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ResetViewButton" Grid.Column="1" Content="Reset view" Height="25" MinWidth="78" Margin="12,0,0,0"
                                    Padding="10,0" FontSize="10" FontWeight="SemiBold" Foreground="#365D88" Background="White"
                                    BorderBrush="#CBD8E7" BorderThickness="1" Cursor="Hand"
                                    ToolTip="Reset synchronized waveform zoom/pan to the full record." Click="DisturbanceReset_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid x:Name="WaveformWorkspaceHost">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White">
                                <controls:ComtradeDisturbanceView x:Name="DisturbanceView" MinHeight="330"/>
                            </ScrollViewer>
                            <Expander x:Name="DigitalEventExpander" Grid.Row="1" Header="Digital events / protection timeline" IsExpanded="True"
                                      Background="#FAFCFF" BorderBrush="#E2E9F2" BorderThickness="0,1,0,0" Padding="8,4" MaxHeight="175">
                                <DataGrid x:Name="DigitalEventGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeaderWidth="0"
                                          SelectionMode="Single" SelectionUnit="FullRow" FontSize="9.7"
                                          SelectionChanged="DigitalEventGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="92"/>
                                        <DataGridTextColumn Header="Δ previous" Binding="{Binding DeltaText}" Width="86"/>
                                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="*"/>
                                        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="110"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="58"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Grid>

                        <!-- Compatibility one-channel renderer retained internally during P1D migration. -->
                        <controls:ComtradeWaveformView x:Name="WaveformView" MinHeight="330" Visibility="Collapsed"/>
                        <controls:ComtradePhasorView x:Name="PhasorView" MinHeight="330" Visibility="Collapsed"/>
                        <controls:ComtradeHarmonicsView x:Name="HarmonicsView" MinHeight="330" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#F9FBFE" BorderBrush="#DEE6F0" BorderThickness="1" CornerRadius="8" Padding="9,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" FontSize="10.2" Foreground="#687B92" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="FullAnalysisButton" Grid.Column="1" Content="Full analysis" Height="26" MinWidth="94" Margin="12,0,14,0"
                        Padding="12,0" FontSize="10.2" FontWeight="SemiBold" Foreground="#315D91" Background="#F5F9FF"
                        BorderBrush="#C5D8EE" BorderThickness="1" Cursor="Hand"
                        ToolTip="Open the complete Qt analysis workspace for field comparison."
                        Click="FullAnalysis_Click"/>
                <TextBlock Grid.Column="2" Text="P1D • synchronized disturbance workspace" FontSize="9.7" Foreground="#8A99AA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
