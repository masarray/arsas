<Window x:Class="ArIED61850Tester.ComtradeWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArIED61850Tester.Controls"
        Title="ARSAS — COMTRADE Workspace"
        Width="1220" Height="760" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="12" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COMTRADE Workspace" FontSize="19" FontWeight="SemiBold" Foreground="#18324F"/>
                    <TextBlock x:Name="RecordIdentityText" Margin="0,4,0,0" FontSize="11.5" Foreground="#667B94"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EEF6FF" BorderBrush="#C8DEF8" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#2A78DF" VerticalAlignment="Center"/>
                        <TextBlock Text="Native ArdIrec core" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#275D9A"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Station / recorder" FontSize="10.5" Foreground="#8391A5"/>
                    <TextBlock x:Name="StationText" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#263D58" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Channels" FontSize="10.5" Foreground="#8391A5"/>
                    <TextBlock x:Name="ChannelsText" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#263D58"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="Nominal frequency" FontSize="10.5" Foreground="#8391A5"/>
                    <TextBlock x:Name="FrequencyText" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#263D58"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                    <TextBlock Text="Frames" FontSize="10.5" Foreground="#8391A5"/>
                    <TextBlock x:Name="FramesText" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#263D58"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Signals" FontSize="13" FontWeight="SemiBold" Foreground="#263D58" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SignalCountText" Grid.Column="1" FontSize="10.5" Foreground="#7B8CA2" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="SignalList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             SelectionChanged="SignalList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="28" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="#263D58" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,1,0,0" FontSize="9.8" Foreground="#8190A3" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <controls:ComtradeWaveformView x:Name="WaveformView" MinHeight="360"/>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="#F9FBFE" BorderBrush="#DEE6F0" BorderThickness="1" CornerRadius="8" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" FontSize="10.5" Foreground="#687B92" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="P1A • in-process native bridge" FontSize="10" Foreground="#8A99AA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
