<Window x:Class="ArIED61850Tester.BrowserBatchWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write selected Data Attributes · ARSAS"
        Width="760" Height="580" MinWidth="650" MinHeight="420" MaxHeight="690"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F7FA" FontFamily="{StaticResource AppFontFamily}" FontSize="11.5"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Write selected Data Attributes" Foreground="#293E56"
                       FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="IdentityLabel" Foreground="#5F7389" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock Text="One verified DO · exact FC/type · no IEC Control Operate"
                       Foreground="#637990" FontSize="10.5" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Select individual rows, enter new values and inspect the live MMS type before confirming. Writes are sequential, never atomic."
                   TextWrapping="Wrap" Foreground="#596D84" FontSize="10.5" Margin="2,0,2,9"/>
        <DataGrid x:Name="RowsGrid" Grid.Row="2" ItemsSource="{Binding Rows}"
                  Style="{StaticResource ModernDataGrid}" IsReadOnly="False"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeight="35" ColumnHeaderHeight="31" MinHeight="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Write" Width="53">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Eligible}" ToolTip="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="DA (exact MMS)" Binding="{Binding ReferenceText}"
                                    IsReadOnly="True" Width="2.4*" MinWidth="220"/>
                <DataGridTextColumn Header="FC" Binding="{Binding Fc}" IsReadOnly="True" Width="45"/>
                <DataGridTextColumn Header="MMS type" Binding="{Binding Type}" IsReadOnly="True" Width="89"/>
                <DataGridTextColumn Header="Before" Binding="{Binding Old}" IsReadOnly="True" Width="90"/>
                <DataGridTemplateColumn Header="New value" Width="1.1*" MinWidth="108">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Eligible}" Padding="5,3" FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Result / reason" Binding="{Binding Status}"
                                    IsReadOnly="True" Width="1.7*" MinWidth="145"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="1,10,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusLabel" Text="No Write sent. Select changed values for read-only inspection."
                       TextWrapping="Wrap" Foreground="#506780" FontSize="10.5" Margin="0,0,0,8"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="A confirmed Write is not physical feedback."
                           Foreground="#70849B" FontSize="10" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="InspectButton" Grid.Column="1" Content="Inspect selected"
                        Style="{StaticResource SoftButton}" Width="117" Height="31"
                        Margin="0,0,7,0" Click="Inspect_Click"/>
                <Button x:Name="WriteButton" Grid.Column="2" Content="Write selected…"
                        Width="118" Height="31" IsEnabled="False" Background="#255F99"
                        Foreground="White" BorderBrush="#255F99"
                        Margin="0,0,7,0" Click="Write_Click"/>
                <Button Grid.Column="3" Content="Close" Width="72" Height="31"
                        Style="{StaticResource SoftButton}" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>