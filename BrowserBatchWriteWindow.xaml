<Window x:Class="ArIED61850Tester.BrowserBatchWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Data to IED"
        Width="660" Height="490" MinWidth="570" MinHeight="360" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F7FA" FontFamily="{StaticResource AppFontFamily}" FontSize="11.5"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Write Data to IED" Foreground="#293E56"
                       FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="IdentityLabel" Foreground="#5F7389" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock Text="One verified DO · exact FC/type · no IEC Control Operate"
                       Foreground="#637990" FontSize="10.5" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Check attributes and choose values. Inspect verifies the current IED types before Write."
                   TextTrimming="CharacterEllipsis" Foreground="#596D84" FontSize="10.5" Margin="2,0,2,7"/>
        <DataGrid x:Name="RowsGrid" Grid.Row="2" ItemsSource="{Binding Rows}"
                  Style="{StaticResource ModernDataGrid}" IsReadOnly="False"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeight="35" ColumnHeaderHeight="31" MinHeight="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header=" " Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Eligible}" VerticalAlignment="Center"
                                      HorizontalAlignment="Center" ToolTip="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Data Attribute" Binding="{Binding DisplayName}"
                                    Width="2*" MinWidth="145" IsReadOnly="True"/>
                <DataGridTextColumn Header="FC" Binding="{Binding Fc}" Width="43" IsReadOnly="True"/>
                <DataGridTextColumn Header="Current" Binding="{Binding Old}" Width="1*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Value" Width="1.3*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Eligible}" Visibility="{Binding TextEditorVisibility}"
                                         Padding="6,3" ToolTip="{Binding Status}"/>
                                <ComboBox ItemsSource="{Binding BooleanChoices}"
                                          SelectedItem="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding BooleanEditorVisibility}"
                                          IsEnabled="{Binding Eligible}" Padding="5,1"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"
                                    Width="1.4*" MinWidth="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="1,10,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusLabel" Text="No Write sent. Select changed values for read-only inspection."
                       TextWrapping="Wrap" Foreground="#506780" FontSize="10.5" Margin="0,0,0,8"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Writes are sequential."
                           Foreground="#70849B" FontSize="10" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="InspectButton" Grid.Column="1" Content="Inspect"
                        Style="{StaticResource SoftButton}" Width="89" Height="31"
                        Margin="0,0,7,0" Click="Inspect_Click"/>
                <Button x:Name="WriteButton" Grid.Column="2" Content="Write"
                        Width="94" Height="31" IsEnabled="False" Background="#255F99"
                        Foreground="White" BorderBrush="#255F99"
                        Margin="0,0,7,0" Click="Write_Click"/>
                <Button Grid.Column="3" Content="Close" Width="72" Height="31"
                        Style="{StaticResource SoftButton}" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>