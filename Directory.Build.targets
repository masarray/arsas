<Project>
  <Import Project="$(MSBuildThisFileDirectory)evidence\SmartDiscoveryPromotion.props"
          Condition="Exists('$(MSBuildThisFileDirectory)evidence\SmartDiscoveryPromotion.props')" />

  <PropertyGroup>
    <!-- The field-capture workflow is an explicit evidence lane and may continue to
         exercise the smart route before production promotion is authorized. -->
    <EnableSmartDiscoveryCaptureRoute Condition="'$(EnableSmartDiscoveryCaptureRoute)' == '' and '$(GITHUB_WORKFLOW)' == 'Smart Discovery Field Capture Build'">true</EnableSmartDiscoveryCaptureRoute>

    <!-- Production defaults to the reviewed tracked promotion switch. Until P0-5g
         authority flips SmartDiscoveryProductionPromoted, normal builds stay legacy. -->
    <EnableSmartDiscoveryCaptureRoute Condition="'$(EnableSmartDiscoveryCaptureRoute)' == '' and '$(SmartDiscoveryProductionPromoted)' == 'true'">true</EnableSmartDiscoveryCaptureRoute>
    <EnableSmartDiscoveryCaptureRoute Condition="'$(EnableSmartDiscoveryCaptureRoute)' == ''">false</EnableSmartDiscoveryCaptureRoute>
  </PropertyGroup>

  <Target Name="EnableSmartDiscoveryCaptureRoute"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'ArIED61850Tester' and '$(EnableSmartDiscoveryCaptureRoute)' == 'true'">
    <Message Importance="High" Text="P0-5g smart discovery route enabled (field evidence or reviewed production promotion)." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\enable-smart-discovery-capture.ps1&quot;" />
  </Target>
</Project>
