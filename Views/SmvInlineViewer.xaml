<UserControl x:Class="ArIED61850Tester.Views.SmvInlineViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Loaded="Viewer_Loaded" Unloaded="Viewer_Unloaded">
    <UserControl.Resources>
        <Style x:Key="SvPane" TargetType="Border">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#DAE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource SvPane}" Padding="9,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sampled Values" FontSize="14" FontWeight="SemiBold" Foreground="#233B58"/>
                    <TextBlock Text="IEC 61850-9-2 · passive Ethernet" FontSize="10" Foreground="#667E98"/>
                </StackPanel>
                <ComboBox x:Name="AdapterCombo" Grid.Column="2" Height="32" VerticalAlignment="Center"
                          ItemsSource="{Binding Adapters}" DisplayMemberPath="DisplayText"
                          ToolTip="Ethernet/Npcap capture adapter; independent of IED and SCL."
                          SelectionChanged="Adapter_SelectionChanged"/>
                <Button Grid.Column="4" Content="↻" Width="32" Height="32" Click="RefreshAdapters_Click"
                        ToolTip="Refresh Ethernet adapter names" Background="#EBF3FF" BorderBrush="#C6DBF3"/>
                <ComboBox x:Name="FrequencyCombo" Grid.Column="6" Width="76" Height="32"
                          VerticalAlignment="Center" SelectedIndex="0"
                          ToolTip="Nominal frequency for resolving trusted sample rate">
                    <ComboBoxItem Content="50 Hz" Tag="50"/>
                    <ComboBoxItem Content="60 Hz" Tag="60"/>
                </ComboBox>
                <Button x:Name="StartButton" Grid.Column="8" Content="▶ Start" MinWidth="77" Height="32"
                        Background="#176BBA" Foreground="White" BorderBrush="#176BBA"
                        Click="Start_Click" ToolTip="Start raw SV sniff without an IED or SCL."/>
                <Button x:Name="StopButton" Grid.Column="10" Content="■ Stop" MinWidth="72" Height="32"
                        IsEnabled="False" Click="Stop_Click" Background="#F2F5F9" BorderBrush="#D7DFEA"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="310"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" MinWidth="170"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="1.2*" MinWidth="270"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="0.95*" MinWidth="270"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SvPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="SV Streams" FontSize="12" FontWeight="SemiBold" Foreground="#243C59"/>
                        <TextBlock Text="{Binding StreamCountText}" FontSize="10" Foreground="#4A77A7"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="StreamList" Grid.Row="2" ItemsSource="{Binding Streams}"
                              SelectionChanged="Stream_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False"
                              BorderThickness="0" EnableRowVirtualization="True"
                              SelectionMode="Single" FontSize="10.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="svID" Binding="{Binding SvId}" Width="*"/>
                            <DataGridTextColumn Header="APPID" Binding="{Binding AppId}" Width="59"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StreamDetail}" FontSize="10"
                               Foreground="#526987" TextWrapping="Wrap"
                               ToolTip="{Binding StreamDetail}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SvPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Waveforms" FontSize="12" FontWeight="SemiBold" Foreground="#243C59"/>
                        <TextBlock Text="RAW INT32 · 2 cycles" FontSize="10" Foreground="#6A819E"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Canvas x:Name="WaveformCanvas" Grid.Row="2" Background="#F7FAFF"
                            ClipToBounds="True" SizeChanged="Waveform_Resized"/>
                    <TextBlock Grid.Row="4" Text="{Binding WaveformStatus}" FontSize="10"
                               Foreground="#536E90" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding WaveformStatus}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.08*" MinHeight="170"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="0.92*" MinHeight="145"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource SvPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Phasors" FontSize="12" FontWeight="SemiBold" Foreground="#243C59"/>
                        <Canvas x:Name="PhasorCanvas" Grid.Row="1" SizeChanged="Phasor_Resized"
                                Background="#F7FAFF" ClipToBounds="True"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource SvPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Measurements" FontSize="12" FontWeight="SemiBold" Foreground="#243C59"/>
                            <TextBlock Text="raw counts, not V / A" FontSize="9.6" Foreground="#6A819E"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Measurements}" IsReadOnly="True"
                                  AutoGenerateColumns="False" RowHeaderWidth="0" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" FontSize="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Channel" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="RMS" Binding="{Binding RmsText}" Width="66"/>
                                <DataGridTextColumn Header="Fund." Binding="{Binding FundamentalRmsText}" Width="66"/>
                                <DataGridTextColumn Header="Angle" Binding="{Binding AngleText}" Width="58"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,7,0,0"
                    Background="#EAF3FF" BorderBrush="#D3E4F7" BorderThickness="1"
                    CornerRadius="7" Padding="9,6">
                <TextBlock Text="{Binding CaptureStatus}" FontSize="10.7" Foreground="#355A82"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CaptureStatus}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
