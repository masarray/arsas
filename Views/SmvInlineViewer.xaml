<UserControl x:Class="ArIED61850Tester.Views.SmvInlineViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dig="clr-namespace:ProcessBus.App.Wpf.Controls"
             Background="#071625" Loaded="Viewer_Loaded" Unloaded="Viewer_Unloaded">
    <UserControl.Resources>
        <Style x:Key="SvPane" TargetType="Border">
            <Setter Property="Background" Value="#0C1B2B"/>
            <Setter Property="BorderBrush" Value="#1B344F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource SvPane}" Padding="9,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sampled Values" FontSize="14" FontWeight="SemiBold" Foreground="#E3F2FF"/>
                    <TextBlock Text="IEC 61850-9-2 · passive Ethernet" FontSize="10" Foreground="#8DA8C3"/>
                </StackPanel>
                <ComboBox x:Name="AdapterCombo" Grid.Column="2" Height="32" VerticalAlignment="Center"
                          ItemsSource="{Binding Adapters}" DisplayMemberPath="DisplayText"
                          ToolTip="Ethernet/Npcap capture adapter; independent of IED and SCL."
                          SelectionChanged="Adapter_SelectionChanged"/>
                <Button Grid.Column="4" Content="↻" Width="32" Height="32" Click="RefreshAdapters_Click"
                        ToolTip="Refresh Ethernet adapter names" Background="#EBF3FF" BorderBrush="#C6DBF3"/>
                <ComboBox x:Name="FrequencyCombo" Grid.Column="6" Width="76" Height="32"
                          VerticalAlignment="Center" SelectedIndex="0"
                          ToolTip="Nominal frequency for resolving trusted sample rate">
                    <ComboBoxItem Content="50 Hz" Tag="50"/>
                    <ComboBoxItem Content="60 Hz" Tag="60"/>
                </ComboBox>
                <Button x:Name="StartButton" Grid.Column="8" Content="▶ Start" MinWidth="77" Height="32"
                        Background="#176BBA" Foreground="White" BorderBrush="#176BBA"
                        Click="Start_Click" ToolTip="Start raw SV sniff without an IED or SCL."/>
                <Button x:Name="StopButton" Grid.Column="10" Content="■ Stop" MinWidth="72" Height="32"
                        IsEnabled="False" Click="Stop_Click" Background="#152B42" Foreground="#D9EFFF" BorderBrush="#31516F"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="310"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" MinWidth="170"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="1.25*" MinWidth="290"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="1.0*" MinWidth="295"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SvPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="SV Streams" FontSize="12" FontWeight="SemiBold" Foreground="#E3F2FF"/>
                        <TextBlock Text="{Binding StreamCountText}" FontSize="10" Foreground="#7DC3FE"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="StreamList" Grid.Row="2" ItemsSource="{Binding Streams}"
                              SelectionChanged="Stream_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#0C1B2B" Foreground="#D9EFFF" BorderBrush="#31516F"
                              RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False"
                              BorderThickness="0" EnableRowVirtualization="True"
                              SelectionMode="Single" FontSize="10.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="svID" Binding="{Binding SvId}" Width="*"/>
                            <DataGridTextColumn Header="APPID" Binding="{Binding AppId}" Width="59"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StreamDetail}" FontSize="10"
                               Foreground="#A7B8CB" TextWrapping="Wrap"
                               ToolTip="{Binding StreamDetail}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SvPane}" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,3,4,0">
                        <TextBlock Text="Waveforms" FontSize="12" FontWeight="SemiBold" Foreground="#E3F2FF"/>
                        <TextBlock Text="RAW INT32 · counter anchored" FontSize="10" Foreground="#86A9C7"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,3,0,1">
                        <TextBlock Foreground="#A7B8CB" FontSize="10" VerticalAlignment="Center" Text="Show" Margin="0,0,5,0"/>
                        <ComboBox x:Name="ShowModeCombo" Width="83" Height="26" SelectedIndex="0"
                                  SelectionChanged="WaveformOptionsChanged" FontSize="10">
                            <ComboBoxItem Content="Both"/>
                            <ComboBoxItem Content="Group A"/>
                            <ComboBoxItem Content="Group B"/>
                        </ComboBox>
                        <TextBlock Foreground="#A7B8CB" FontSize="10" VerticalAlignment="Center" Text="Layout" Margin="10,0,5,0"/>
                        <ComboBox x:Name="LayoutModeCombo" Width="76" Height="26" SelectedIndex="0"
                                  SelectionChanged="WaveformOptionsChanged" FontSize="10">
                            <ComboBoxItem Content="Overlay"/>
                            <ComboBoxItem Content="Stacked"/>
                        </ComboBox>
                        <TextBlock Foreground="#A7B8CB" FontSize="10" VerticalAlignment="Center" Text="Scale" Margin="10,0,5,0"/>
                        <ComboBox x:Name="ScaleModeCombo" Width="105" Height="26" SelectedIndex="0"
                                  SelectionChanged="WaveformOptionsChanged" FontSize="10">
                            <ComboBoxItem Content="Auto Peak Hold"/>
                            <ComboBoxItem Content="Auto"/>
                        </ComboBox>
                    </StackPanel>
                    <dig:WaveformPanelControl x:Name="WaveformView" Grid.Row="4"
                            Snapshot="{Binding CurrentWaveform}" StreamKey="{Binding CurrentStreamKey}"
                            IsStreamLive="{Binding IsLiveSnapshot}" TimebaseMode="2 cycles"
                            VoltageScale="Auto Peak Hold" CurrentScale="Auto Peak Hold"
                            ShowMode="Both" LayoutMode="Overlay" MarkersEnabled="True"/>
                    <TextBlock Grid.Row="5" Text="{Binding WaveformStatus}" Margin="4,4,4,0"
                               FontSize="10" Foreground="#9BB9D4" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding WaveformStatus}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.30*" MinHeight="210"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="0.70*" MinHeight="155"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource SvPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Phasors" FontSize="12" FontWeight="SemiBold" Foreground="#E3F2FF"/>
                        <dig:PhasorDiagramControl x:Name="PhasorView" Grid.Row="1"
                                ItemsSource="{Binding CurrentPhasors}"
                                IsStreamLive="{Binding IsLiveSnapshot}"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource SvPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Measurements" FontSize="12" FontWeight="SemiBold" Foreground="#E3F2FF"/>
                            <TextBlock Text="Ch1 reference = 0° · raw counts" FontSize="9.6" Foreground="#9CB1C6"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Measurements}" IsReadOnly="True"
                                  AutoGenerateColumns="False" RowHeaderWidth="0" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" FontSize="10" Background="#0C1B2B" Foreground="#D9EFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Channel" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="RMS" Binding="{Binding RmsText}" Width="66"/>
                                <DataGridTextColumn Header="Fund." Binding="{Binding FundamentalRmsText}" Width="66"/>
                                <DataGridTextColumn Header="Angle" Binding="{Binding AngleText}" Width="58"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,7,0,0"
                    Background="#102A41" BorderBrush="#254563" BorderThickness="1"
                    CornerRadius="7" Padding="9,6">
                <TextBlock Text="{Binding CaptureStatus}" FontSize="10.7" Foreground="#C0D7EF"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CaptureStatus}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
