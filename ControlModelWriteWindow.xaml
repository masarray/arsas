<Window x:Class="ArIED61850Tester.ControlModelWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Data to IED" Width="510" Height="290" MinWidth="490"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F7FB" FontFamily="{StaticResource AppFontFamily}"
        Icon="Assets/app-icon.ico" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ReferenceLabel" Grid.Row="0" FontSize="11.5"
                   Foreground="{StaticResource Ink}" FontFamily="{StaticResource AppCodeFontFamily}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource Line}"
                CornerRadius="8" Background="#F8FAFC" Padding="10,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ctlModel [CF]" VerticalAlignment="Center"
                           Foreground="{StaticResource Ink}" FontSize="12"/>
                <ComboBox x:Name="ModelPicker" Grid.Column="1" Height="31"
                          ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                          SelectionChanged="ModelPicker_SelectionChanged" IsEnabled="False"/>
                <Button x:Name="ReadButton" Grid.Column="2" Content="Read" Click="Read_Click"
                        Style="{StaticResource SoftButton}" Height="29" MinHeight="29"
                        Padding="10,3" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="2,10,0,5">
            <TextBlock x:Name="StatusLabel" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}" Text="Reading ctlModel from IED…"/>
            <TextBox x:Name="FailureDetails" Visibility="Collapsed" Margin="0,7,0,0"
                     IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxHeight="73" MinHeight="48"
                     FontSize="11" Padding="8,6" BorderThickness="1" BorderBrush="#E7C4C4"
                     Background="#FFF8F8" Foreground="#923C3C"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="WriteButton" Content="Write" Click="Write_Click"
                    Style="{StaticResource PrimaryButton}" Width="93" Height="31"
                    MinHeight="31" Padding="10,4" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Close_Click" Style="{StaticResource SoftButton}"
                    Width="85" Height="31" MinHeight="31" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
