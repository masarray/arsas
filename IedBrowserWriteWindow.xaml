<Window x:Class="ArIED61850Tester.IedBrowserWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMS Write · IED Browser" Width="1010" Height="670"
        MinWidth="760" MinHeight="435" WindowStartupLocation="CenterOwner"
        Background="#F5F8FC" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="14,12" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="3,0,3,12">
            <TextBlock Text="MMS configuration Write" FontSize="16" FontWeight="SemiBold"
                       Foreground="#24354B"/>
            <TextBlock x:Name="IdentityText" FontSize="11.5" Foreground="#596C82"
                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Only live-discovered CF / DC / SP / SG / SE attributes. CO command services, process values and RCBs are excluded."
                       FontSize="11" Foreground="#8A5B17" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Select each DA, enter its typed value, then confirm. Bulk is sequential (not atomic); stops at first failure. Readback is required."
                   FontSize="11" Foreground="#3E5671" TextWrapping="Wrap" Margin="3,0,0,9"/>
        <DataGrid Grid.Row="2" x:Name="WriteRowsGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" RowHeight="35" ColumnHeaderHeight="33"
                  AlternatingRowBackground="#F1F5FA" Background="White" BorderBrush="#C6D3E3"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  EnableRowVirtualization="True" MinHeight="0" ClipToBounds="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Write" Binding="{Binding Selected, Mode=TwoWay}"
                                        Width="54"/>
                <DataGridTextColumn Header="Exact IEC DA reference" Binding="{Binding Reference}"
                                    Width="2.6*" MinWidth="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="FC" Binding="{Binding FunctionalConstraint}"
                                    Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}"
                                    Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Live before" Binding="{Binding Current}"
                                    Width="1*" MinWidth="95" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="New value" Width="1.3*" MinWidth="132">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="1">
                                <TextBox x:Name="ValueEditor" Text="{Binding RequestedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5,3" BorderBrush="#CED7E3" Background="White"/>
                                <ComboBox x:Name="CtlPicker" Visibility="Collapsed"
                                          SelectedValue="{Binding RequestedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag" FontSize="11.5">
                                    <ComboBoxItem Tag="0" Content="0 · status-only"/>
                                    <ComboBoxItem Tag="1" Content="1 · direct-normal"/>
                                    <ComboBoxItem Tag="2" Content="2 · sbo-normal"/>
                                    <ComboBoxItem Tag="3" Content="3 · direct-enhanced"/>
                                    <ComboBoxItem Tag="4" Content="4 · sbo-enhanced"/>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Result" Binding="{Binding Result}"
                                    Width="1.1*" MinWidth="140" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="3,10,3,8"
                   Text="No MMS operation has been sent." TextWrapping="Wrap"
                   Foreground="#455E78" FontSize="11.5"/>
        <Grid Grid.Row="4" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Never use Write as a substitute for IEC control Operate."
                       Foreground="#8F5B18" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="ReadButton" Content="Read selected"
                    Width="110" Height="31" Margin="0,0,8,0" Click="Read_Click"/>
            <Button Grid.Column="2" x:Name="WriteButton" Content="Write selected…"
                    Width="135" Height="31" Margin="0,0,8,0" Click="Write_Click"
                    Background="#2762AF" Foreground="White"/>
            <Button Grid.Column="3" Content="Close" Width="80" Height="31" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>