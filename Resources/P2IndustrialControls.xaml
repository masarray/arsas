    <DataTemplate x:Key="IconStopContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideCircleStop}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconSaveContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H16 L21,8 V19 A2,2 0 0 1 19,21 Z M17,21 V13 H7 V21 M7,3 V8 H15" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconExcelContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideFileSpreadsheet}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconPdfContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideFileText}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconExportContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucidePackageOpen}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconWorkspaceContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideArrowLeftRight}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>

    <DataTemplate x:Key="IconExplorerNavContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideNetwork}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><ContentPresenter Content="{Binding}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconMonitorNavContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideActivity}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><ContentPresenter Content="{Binding}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconEventsNavContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideListChecks}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><ContentPresenter Content="{Binding}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconGooseNavContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideRadioTower}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><ContentPresenter Content="{Binding}"/></StackPanel></DataTemplate>
