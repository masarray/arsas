    <Style x:Key="IndustrialSearchTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#2B3740"/>
        <Setter Property="Background" Value="#ECEAE4"/>
        <Setter Property="BorderBrush" Value="#8999A2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11.8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <Viewbox Width="14" Height="14" Margin="9,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Path Data="{StaticResource LucideSearch}" Fill="Transparent" Stroke="#526774"
                                      StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Viewbox>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="31,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Margin="31,0,8,0"
                                       Foreground="#7C888F" FontSize="11.4" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#6F8794"/>
                            <Setter TargetName="Chrome" Property="Background" Value="#F0EEE8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#2474D8"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Chrome" Property="Background" Value="#F3F0EA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustrialUtilityButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="#2C3942"/>
        <Setter Property="Background" Value="#E7E5DF"/>
        <Setter Property="BorderBrush" Value="#87969E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11.6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#DDE2E2"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#667C87"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D2D9DA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustrialPrimaryButton" TargetType="Button" BasedOn="{StaticResource IndustrialUtilityButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#246FC7"/>
        <Setter Property="BorderBrush" Value="#4A8DCE"/>
    </Style>

    <Style x:Key="IndustrialGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#D1D9DB"/>
        <Setter Property="Foreground" Value="#34454F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Height" Value="37"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#A1ADB2"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Icon + current Button.Content. Content bindings stay live when captions change. -->
    <DataTemplate x:Key="IconPrintContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucidePrinter}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconClockContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideClock3}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconComtradeContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucideFileWaveform}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="IconConnectContent"><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="{StaticResource LucidePlugZap}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8"/></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
