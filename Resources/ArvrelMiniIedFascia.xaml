<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Runtime WPF transcription of Assets/black-fascia-ied.svg.
      The source SVG is the visual authority. WPF keeps the card dependency-free and
      exposes LED1 / LED2 / LED3 as live template parts so connection state is readable
      even when the relay fascia is rendered at 50 x 50 px.
    -->

    <Style x:Key="ArsasIedConnectionLed" TargetType="{x:Type Ellipse}">
        <!-- Matches the enlarged lamp geometry from black-fascia-ied.svg. -->
        <Setter Property="Width" Value="22.4"/>
        <Setter Property="Height" Value="18.4"/>
        <Setter Property="Opacity" Value="0.98"/>
        <Setter Property="Stroke" Value="#7A0909"/>
        <Setter Property="StrokeThickness" Value="1.1"/>
        <Setter Property="Fill">
            <Setter.Value>
                <RadialGradientBrush Center="0.48,0.42" GradientOrigin="0.34,0.28" RadiusX="0.64" RadiusY="0.64">
                    <GradientStop Color="#FFF3DF" Offset="0"/>
                    <GradientStop Color="#FFB175" Offset="0.18"/>
                    <GradientStop Color="#FF5538" Offset="0.36"/>
                    <GradientStop Color="#D51616" Offset="0.66"/>
                    <GradientStop Color="#520000" Offset="1"/>
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.95" Color="#FF2A2A"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Engineering cards follow the same operational state as the LIVE / STOP badge.
                 A retained MMS association after Stop must not keep the fascia LEDs green. -->
            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                <Setter Property="Stroke" Value="#0A7A35"/>
                <Setter Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.48,0.42" GradientOrigin="0.34,0.28" RadiusX="0.64" RadiusY="0.64">
                            <GradientStop Color="#F7FFF9" Offset="0"/>
                            <GradientStop Color="#B7FFC9" Offset="0.17"/>
                            <GradientStop Color="#55FF79" Offset="0.36"/>
                            <GradientStop Color="#2DE57A" Offset="0.62"/>
                            <GradientStop Color="#00933F" Offset="0.82"/>
                            <GradientStop Color="#003516" Offset="1"/>
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="1" Color="#32FF75"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <!-- IO/FAT cards expose their equivalent active live state separately. -->
            <DataTrigger Binding="{Binding IsLiveConnected}" Value="True">
                <Setter Property="Stroke" Value="#0A7A35"/>
                <Setter Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.48,0.42" GradientOrigin="0.34,0.28" RadiusX="0.64" RadiusY="0.64">
                            <GradientStop Color="#F7FFF9" Offset="0"/>
                            <GradientStop Color="#B7FFC9" Offset="0.17"/>
                            <GradientStop Color="#55FF79" Offset="0.36"/>
                            <GradientStop Color="#2DE57A" Offset="0.62"/>
                            <GradientStop Color="#00933F" Offset="0.82"/>
                            <GradientStop Color="#003516" Offset="1"/>
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="1" Color="#32FF75"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0.90"
                            To="1"
                            Duration="0:0:0.85"
                            AutoReverse="True"
                            RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ArvrelMiniIedRelayFrontPanelTemplate" TargetType="{x:Type Control}">
        <Grid Width="50" Height="50" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Viewbox Stretch="Uniform">
                <Canvas Width="256" Height="256" Background="Transparent">

                    <!-- Black premium chassis from Assets/black-fascia-ied.svg -->
                    <Rectangle Canvas.Left="12" Canvas.Top="8" Width="232" Height="240" RadiusX="26" RadiusY="26">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#77828C" Offset="0"/>
                                <GradientStop Color="#3E4750" Offset="0.16"/>
                                <GradientStop Color="#13181D" Offset="0.50"/>
                                <GradientStop Color="#39424B" Offset="0.82"/>
                                <GradientStop Color="#0A0D10" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="7" ShadowDepth="3" Opacity="0.40" Color="#000000"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Rectangle Canvas.Left="16" Canvas.Top="12" Width="224" Height="232"
                               RadiusX="22" RadiusY="22" Fill="Transparent"
                               Stroke="#3894A0AB" StrokeThickness="1.2"/>
                    <Rectangle Canvas.Left="19.4" Canvas.Top="15.4" Width="216.9" Height="224.8"
                               RadiusX="19" RadiusY="19" Fill="Transparent"
                               Stroke="#94FFFFFF" StrokeThickness="1"/>

                    <!-- Four visible screw heads -->
                    <Ellipse Canvas.Left="20.3" Canvas.Top="16.2" Width="15.6" Height="15.6" Fill="#161B20"/>
                    <Ellipse Canvas.Left="22.1" Canvas.Top="18.0" Width="12" Height="12" Fill="#A8B0B8" Stroke="#545D66" StrokeThickness="0.8"/>
                    <Line X1="25.4" Y1="23" X2="30.6" Y2="25" Stroke="#49525A" StrokeThickness="1.3"/>
                    <Ellipse Canvas.Left="219.5" Canvas.Top="16.0" Width="15.6" Height="15.6" Fill="#161B20"/>
                    <Ellipse Canvas.Left="221.3" Canvas.Top="17.8" Width="12" Height="12" Fill="#A8B0B8" Stroke="#545D66" StrokeThickness="0.8"/>
                    <Line X1="224.6" Y1="22.8" X2="229.8" Y2="24.8" Stroke="#49525A" StrokeThickness="1.3"/>
                    <Ellipse Canvas.Left="20.3" Canvas.Top="224.1" Width="15.6" Height="15.6" Fill="#161B20"/>
                    <Ellipse Canvas.Left="22.1" Canvas.Top="225.9" Width="12" Height="12" Fill="#A8B0B8" Stroke="#545D66" StrokeThickness="0.8"/>
                    <Ellipse Canvas.Left="220.9" Canvas.Top="223.3" Width="15.6" Height="15.6" Fill="#161B20"/>
                    <Ellipse Canvas.Left="222.7" Canvas.Top="225.1" Width="12" Height="12" Fill="#A8B0B8" Stroke="#545D66" StrokeThickness="0.8"/>

                    <Rectangle Canvas.Left="42.7" Canvas.Top="23.3" Width="4" Height="12.8" RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8AF2FF" Offset="0"/>
                                <GradientStop Color="#49D3FF" Offset="0.45"/>
                                <GradientStop Color="#1577FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Canvas.Left="50.6" Canvas.Top="20.2" Text="ARSAS"
                               Foreground="White" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock Canvas.Left="50.5" Canvas.Top="33.5" Text="IED"
                               Foreground="{TemplateBinding Foreground}" FontFamily="Segoe UI" FontSize="4.5"
                               FontWeight="SemiBold" Opacity="0.55"/>

                    <!-- Large display -->
                    <Rectangle Canvas.Left="40" Canvas.Top="41" Width="125" Height="102"
                               RadiusX="8" RadiusY="8" Stroke="#66717B" StrokeThickness="1.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#59636D" Offset="0"/>
                                <GradientStop Color="#252C33" Offset="0.22"/>
                                <GradientStop Color="#0A0E12" Offset="0.70"/>
                                <GradientStop Color="#040608" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Rectangle Canvas.Left="44" Canvas.Top="45" Width="117" Height="94"
                               RadiusX="6" RadiusY="6" Fill="#090D10" Stroke="#11161A"/>
                    <Rectangle Canvas.Left="47" Canvas.Top="48" Width="111" Height="88"
                               RadiusX="4" RadiusY="4" Stroke="#6D818D" StrokeThickness="0.8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EFF8FB" Offset="0"/>
                                <GradientStop Color="#D4E5EE" Offset="0.45"/>
                                <GradientStop Color="#B5C9D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Path Data="M50,51 H155 L116,91 H50 Z" Fill="#66FFFFFF"/>
                    <TextBlock Canvas.Left="56" Canvas.Top="54" Text="BAY 1" FontSize="7.3" FontWeight="Bold" Foreground="#1B2831"/>
                    <TextBlock Canvas.Left="127" Canvas.Top="54" Width="25" Text="33kV" TextAlignment="Right"
                               FontSize="7.3" FontWeight="Bold" Foreground="#1B2831"/>
                    <Line X1="55" Y1="69" X2="150" Y2="69" Stroke="#1B2831" StrokeThickness="0.9" Opacity="0.7"/>
                    <Line X1="72" Y1="77" X2="132" Y2="77" Stroke="#1B2831" StrokeThickness="3.2"/>
                    <Line X1="102" Y1="79" X2="102" Y2="96" Stroke="#1B2831" StrokeThickness="3.2"/>
                    <Line X1="92" Y1="99" X2="102" Y2="119" Stroke="#1B2831" StrokeThickness="3.2"/>
                    <Line X1="102" Y1="119" X2="102" Y2="129" Stroke="#1B2831" StrokeThickness="3.2"/>

                    <!-- Enlarged SVG LED rail: red offline, bright green online -->
                    <Canvas x:Name="RelayStateRail" Width="72" Height="86" Canvas.Left="168" Canvas.Top="42">
                        <Ellipse x:Name="LED1" Style="{StaticResource ArsasIedConnectionLed}" Canvas.Left="8" Canvas.Top="5"/>
                        <Ellipse Canvas.Left="14" Canvas.Top="8" Width="5.5" Height="3.2" Fill="#88FFFFFF" IsHitTestVisible="False"/>
                        <TextBlock Canvas.Left="34" Canvas.Top="7" Text="TRIP" Foreground="White" FontSize="8" FontWeight="Bold"/>

                        <Ellipse x:Name="LED2" Style="{StaticResource ArsasIedConnectionLed}" Canvas.Left="8" Canvas.Top="32"/>
                        <Ellipse Canvas.Left="14" Canvas.Top="35" Width="5.5" Height="3.2" Fill="#88FFFFFF" IsHitTestVisible="False"/>
                        <TextBlock Canvas.Left="34" Canvas.Top="34" Text="ALM" Foreground="White" FontSize="8" FontWeight="Bold"/>

                        <Ellipse x:Name="LED3" Style="{StaticResource ArsasIedConnectionLed}" Canvas.Left="8" Canvas.Top="59"/>
                        <Ellipse Canvas.Left="14" Canvas.Top="62" Width="5.5" Height="3.2" Fill="#88FFFFFF" IsHitTestVisible="False"/>
                        <TextBlock Canvas.Left="34" Canvas.Top="61" Text="PU" Foreground="White" FontSize="8" FontWeight="Bold"/>
                    </Canvas>

                    <!-- Direction pad -->
                    <Ellipse Canvas.Left="63" Canvas.Top="150" Width="82" Height="82" Fill="#222222" Opacity="0.35"/>
                    <Ellipse Canvas.Left="72" Canvas.Top="159" Width="64" Height="64" Fill="#0481FF" Stroke="#66717B" StrokeThickness="1.3"/>
                    <Path Data="M92,159 Q92,154 98,154 H112 Q118,154 118,160 V174 L111,181 H99 L92,174 Z"
                          Fill="#171C21" Stroke="#6A7580"/>
                    <Path Data="M69,178 Q64,178 64,184 V199 Q64,205 70,205 H86 L93,198 V185 L86,178 Z"
                          Fill="#171C21" Stroke="#6A7580"/>
                    <Path Data="M119,178 H135 Q141,178 141,184 V199 Q141,205 135,205 H119 L112,198 V185 Z"
                          Fill="#171C21" Stroke="#6A7580"/>
                    <Path Data="M92,207 L99,200 H111 L118,207 V221 Q118,227 112,227 H98 Q92,227 92,221 Z"
                          Fill="#171C21" Stroke="#6A7580"/>
                    <Ellipse Canvas.Left="91" Canvas.Top="179" Width="28" Height="28" Fill="#AAB2BA" Stroke="#0F1316" StrokeThickness="1.4"/>
                    <Ellipse Canvas.Left="95" Canvas.Top="183" Width="20" Height="20" Fill="#11161A" Stroke="#616B73"/>
                    <TextBlock Canvas.Left="98" Canvas.Top="188" Width="14" Text="OK" TextAlignment="Center"
                               Foreground="#EEF2F6" FontSize="7.8" FontWeight="Bold"/>

                    <!-- Lower action keys from source SVG -->
                    <Rectangle Canvas.Left="174" Canvas.Top="157" Width="34" Height="31" RadiusX="6" RadiusY="6"
                               Fill="#171C21" Stroke="#66717B"/>
                    <Ellipse Canvas.Left="181" Canvas.Top="163" Width="20" Height="20" Fill="#11161A"
                             Stroke="#FF5D5D" StrokeThickness="2.4"/>
                    <Rectangle Canvas.Left="174" Canvas.Top="195" Width="34" Height="31" RadiusX="6" RadiusY="6"
                               Fill="#171C21" Stroke="#66717B"/>
                    <Rectangle Canvas.Left="190" Canvas.Top="201" Width="3.2" Height="19" Fill="#7CF75C"/>
                </Canvas>
            </Viewbox>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>