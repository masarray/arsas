<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      P1 relay-bench fascia. This template is a direct WPF vector transcription of
      Assets/RelayFascia.svg supplied during physical relay testing. Keeping it as WPF vector
      geometry avoids a new SVG runtime dependency while preserving the uploaded artwork at
      every DPI/zoom level. RelayStateRail remains semantic and data-driven.
    -->
    <ControlTemplate x:Key="ArvrelMiniIedRelayFrontPanelTemplate" TargetType="{x:Type Control}">
        <Grid Width="50" Height="50" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Viewbox x:Name="RelayFasciaArtwork" Stretch="Uniform">
                <Canvas Width="425" Height="425" Background="Transparent">
                    <Rectangle Canvas.Left="36.73" Canvas.Top="8.54" Width="352.94" Height="409"
                               Fill="#C0C0C0" Stroke="#000000" StrokeThickness="5"/>

                    <Canvas RenderTransformOrigin="0,0">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="0.984335,0,0,0.984335,-162.177,-31.1365"/>
                        </Canvas.RenderTransform>

                        <Canvas RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <MatrixTransform Matrix="1,0,0,1,64.19,-12.41"/>
                            </Canvas.RenderTransform>
                            <Path Fill="#000000" StrokeThickness="0"
                                  Data="M188.56,343.64 L239.79,343.64 L239.79,292.41 L292.34,292.41 L292.34,343.64 L343.57,343.64 L343.57,396.19 L292.34,396.19 L292.34,447.42 L239.79,447.42 L239.79,396.19 L188.56,396.19 Z"/>
                        </Canvas>

                        <Canvas RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-45" CenterX="330.25" CenterY="357.5"/>
                                    <MatrixTransform Matrix="1,0,0,1,-229.75,86"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="493" Canvas.Top="267" Width="134" Height="9" Fill="#C0C0C0"/>
                            <Rectangle Canvas.Left="494" Canvas.Top="267" Width="134" Height="9" Fill="#C0C0C0">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="90" CenterX="561" CenterY="271.5"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </Canvas>

                    <Rectangle Canvas.Left="77.73" Canvas.Top="48.54" Width="176.35" Height="176"
                               Fill="#F2F2F2" Stroke="#000000" StrokeThickness="1"/>

                    <Canvas RenderTransformOrigin="0,0">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="1,0,0,1,-103.182,-24.4604"/>
                        </Canvas.RenderTransform>
                        <Line X1="226" Y1="85.5" X2="308" Y2="84.5" Stroke="#000000" StrokeThickness="3"/>
                        <Line X1="266.67" Y1="84.46" X2="266.67" Y2="102.3" Stroke="#000000" StrokeThickness="3"/>
                        <Line X1="266.67" Y1="138.26" X2="266.67" Y2="154.48" Stroke="#000000" StrokeThickness="3"/>
                        <Line X1="247.23" Y1="108.95" X2="266.89" Y2="138.82" Stroke="#000000" StrokeThickness="3"/>
                        <Ellipse Canvas.Left="247.45" Canvas.Top="154.84" Width="38.38" Height="38.9"
                                 Fill="Transparent" Stroke="#000000" StrokeThickness="3"/>
                        <Ellipse Canvas.Left="247.97" Canvas.Top="178.32" Width="38.38" Height="38.9"
                                 Fill="Transparent" Stroke="#000000" StrokeThickness="3"/>
                        <Line X1="266.67" Y1="217.45" X2="266.67" Y2="241.72" Stroke="#000000" StrokeThickness="3"/>
                    </Canvas>

                    <Canvas RenderTransformOrigin="0,0">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="0.857143,0,0,0.857143,-59.9451,25.1036"/>
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="401.25" Canvas.Top="272.52" Width="63.38" Height="63.38" Fill="#000000"/>
                        <Rectangle Canvas.Left="401.25" Canvas.Top="354" Width="63.38" Height="63.38" Fill="#000000"/>
                        <Ellipse Canvas.Left="414.85" Canvas.Top="286.12" Width="36.18" Height="36.18"
                                 Fill="#000000" Stroke="#FF5656" StrokeThickness="3"/>
                        <Line X1="432.94" Y1="365.6" X2="432.94" Y2="405.78" Stroke="#00FF7F" StrokeThickness="3"/>
                    </Canvas>

                    <Canvas RenderTransformOrigin="0,0">
                        <Canvas.RenderTransform>
                            <MatrixTransform Matrix="1.36613,0,0,1.36613,-274.122,-51.6847"/>
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="413.41" Canvas.Top="73" Width="30" Height="30" Fill="#FF0000"/>
                        <Rectangle Canvas.Left="413.41" Canvas.Top="122" Width="30" Height="30" Fill="#FF0000"/>
                        <Rectangle Canvas.Left="413.41" Canvas.Top="172" Width="30" Height="30" Fill="#FF0000"/>
                    </Canvas>
                </Canvas>
            </Viewbox>

            <Border x:Name="RelayStateRail"
                    Height="2.2"
                    Margin="6,0,6,1.4"
                    VerticalAlignment="Bottom"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="1.1"
                    Opacity="0.92"/>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
