<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ARSAS premium IED fascia. This is the WPF vector runtime counterpart of
      Assets/RelayFascia.svg. The app installs this template into the existing
      IedRelayFrontPanelTemplate key at startup, so no SVG runtime dependency is
      required and the artwork remains sharp at every DPI.

      The three right-side lamps intentionally represent connectivity as requested:
      red = offline/disconnected, green = online/connected. They bind directly to
      Iec61850MonitorDevice.IsConnected and use a restrained opacity pulse so the
      indication reads as live without adding expensive per-frame animation.
    -->

    <Style x:Key="ArsasIedConnectionLed" TargetType="Ellipse">
        <Setter Property="Width" Value="13.2"/>
        <Setter Property="Height" Value="13.2"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="Stroke" Value="#5E0B0B"/>
        <Setter Property="StrokeThickness" Value="0.55"/>
        <Setter Property="Fill">
            <Setter.Value>
                <RadialGradientBrush Center="0.46,0.40" GradientOrigin="0.38,0.30" RadiusX="0.64" RadiusY="0.64">
                    <GradientStop Color="#FFF3DF" Offset="0"/>
                    <GradientStop Color="#FFB175" Offset="0.20"/>
                    <GradientStop Color="#FF5538" Offset="0.38"/>
                    <GradientStop Color="#AA1010" Offset="0.72"/>
                    <GradientStop Color="#450000" Offset="1"/>
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.72" Color="#FF3B30"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Stroke" Value="#07562E"/>
                <Setter Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.46,0.40" GradientOrigin="0.38,0.30" RadiusX="0.64" RadiusY="0.64">
                            <GradientStop Color="#F0FFF5" Offset="0"/>
                            <GradientStop Color="#A2FFCA" Offset="0.20"/>
                            <GradientStop Color="#2DE57A" Offset="0.42"/>
                            <GradientStop Color="#0A8544" Offset="0.76"/>
                            <GradientStop Color="#003A1C" Offset="1"/>
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.72" Color="#23D975"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <!-- IO/FAT cards use IoTestIedPlan, whose equivalent live flag has a different name. -->
            <DataTrigger Binding="{Binding IsLiveConnected}" Value="True">
                <Setter Property="Stroke" Value="#07562E"/>
                <Setter Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.46,0.40" GradientOrigin="0.38,0.30" RadiusX="0.64" RadiusY="0.64">
                            <GradientStop Color="#F0FFF5" Offset="0"/>
                            <GradientStop Color="#A2FFCA" Offset="0.20"/>
                            <GradientStop Color="#2DE57A" Offset="0.42"/>
                            <GradientStop Color="#0A8544" Offset="0.76"/>
                            <GradientStop Color="#003A1C" Offset="1"/>
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.72" Color="#23D975"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.82" To="1"
                                         Duration="0:0:0.9"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

