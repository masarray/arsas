                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="{StaticResource MaterialPlayIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="White"/></Viewbox>
                                        <TextBlock Text="Start" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource SoftButton}" Click="StopGooseSubscriber_Click"
                                        Visibility="{Binding GooseStopVisibility}" IsEnabled="{Binding CanStopGooseSubscriber}" Padding="11,6" MinHeight="34">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="{StaticResource MaterialStopIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="{StaticResource Warning}"/></Viewbox>
                                        <TextBlock Text="Stop"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Style="{StaticResource SoftButton}" Click="ClearGooseSubscriber_Click"
                                        Visibility="{Binding GooseClearVisibility}" Padding="11,6" MinHeight="34" ToolTip="Clear captured streams">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="{StaticResource MaterialCloseIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="{StaticResource Danger}"/></Viewbox>
                                        <TextBlock Text="Clear"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding GooseAdapters}" SelectedItem="{Binding SelectedGooseAdapter, Mode=TwoWay}"
                                          TextSearch.TextPath="DisplayText" Style="{StaticResource ModernComboBox}" MinHeight="34" Height="34" Padding="10,4"
                                          IsEnabled="{Binding CanRefreshGooseConfiguration}" ToolTip="{Binding SelectedGooseAdapterDetail}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource IedIconButton}" Click="RefreshGooseAdapters_Click"
                                        IsEnabled="{Binding CanRefreshGooseConfiguration}" ToolTip="Refresh adapters">
                                    <Viewbox Width="15" Height="15"><Path Data="{StaticResource MaterialRefreshIcon}" Style="{StaticResource MaterialIconGlyph}"/></Viewbox>
                                </Button>

                                <Border Grid.Column="4" CornerRadius="9" Padding="8,3" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F2F4F7"/>
                                            <Setter Property="BorderBrush" Value="#D0D5DD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGooseCapturing}" Value="True">
                                                    <Setter Property="Background" Value="#E8F8EF"/>
                                                    <Setter Property="BorderBrush" Value="#86D3A7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding GooseCaptureStateText}" FontSize="9.8" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#667085"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGooseCapturing}" Value="True"><Setter Property="Foreground" Value="#067647"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="6" Text="{Binding GooseStatusText}" FontSize="10.7" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding GooseBindingText}"/>
                                <TextBlock Grid.Column="7" Text="{Binding GooseCounterText}" FontSize="10.4" FontWeight="SemiBold" Foreground="#45648E"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Expander x:Name="GooseCaptureOptionsExpander" Grid.Row="4" Header="Capture options" IsExpanded="False"
                                      Foreground="#52677E" FontSize="10.5" FontWeight="SemiBold">
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="330"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BPF filter" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding GooseCaptureFilter, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32" Height="32" Padding="9,4" FontFamily="{StaticResource AppCodeFontFamily}" FontSize="10.2"
                                             IsEnabled="{Binding CanRefreshGooseConfiguration}" ToolTip="GOOSE BPF capture filter"/>
                                    <Button Grid.Column="3" Style="{StaticResource IedIconButton}" Click="RefreshGooseModels_Click"
                                            IsEnabled="{Binding CanRefreshGooseConfiguration}" ToolTip="Refresh SCL/live model bindings">
                                        <Viewbox Width="15" Height="15"><Path Data="{StaticResource MaterialTuneIcon}" Style="{StaticResource MaterialIconGlyph}"/></Viewbox>
                                    </Button>
                                    <TextBlock Grid.Column="5" Text="{Binding GooseBindingText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding GooseBindingText}"/>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource WorkspaceCard}" Padding="9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Streams" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding GooseStreams}" SelectedItem="{Binding SelectedGooseStream, Mode=TwoWay}"
                                          IsReadOnly="True" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeight="37">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="ToolTip" Value="{Binding DiagnosticsSummary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiagnostics}" Value="True">
                                                    <Setter Property="Background" Value="#FFFAEB"/>
                                                    <Setter Property="BorderBrush" Value="#FEC84B"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E7F0FF"/>
                                                    <Setter Property="BorderBrush" Value="#6F9FF1"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IED" Binding="{Binding ModelIedName}" Width="105" MinWidth="85"/>
                                        <DataGridTextColumn Header="APPID" Binding="{Binding AppIdText}" Width="70"/>
                                        <DataGridTextColumn Header="goCBRef" Binding="{Binding GoCbRef}" Width="205" MinWidth="150"/>
                                        <DataGridTextColumn Header="DataSet" Binding="{Binding DataSetReference}" Width="205" MinWidth="150"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceMac}" Width="118"/>
                                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationMac}" Width="118"/>
                                        <DataGridTextColumn Header="VLAN" Binding="{Binding VlanText}" Width="96"/>
                                        <DataGridTextColumn Header="stNum" Binding="{Binding StateNumberText}" Width="64"/>
                                        <DataGridTextColumn Header="sqNum" Binding="{Binding SequenceNumberText}" Width="64"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding SequenceStatus}" Width="104"/>
                                        <DataGridTextColumn Header="TAL" Binding="{Binding TimeAllowedToLiveText}" Width="76"/>
                                        <DataGridTextColumn Header="confRev" Binding="{Binding ConfigurationRevisionText}" Width="74"/>
                                        <DataGridTextColumn Header="Flags" Binding="{Binding FlagsText}" Width="90"/>
                                        <DataGridTextColumn Header="Δ" Binding="{Binding ChangedValueCount}" Width="52"/>
                                        <DataGridTextColumn Header="Packets" Binding="{Binding PacketCount}" Width="70"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding BindingSource}" Width="90"/>
                                        <DataGridTextColumn Header="Seen" Binding="{Binding LastSeenText}" Width="100"/>
                                        <DataGridTextColumn Header="Diagnostics" Binding="{Binding DiagnosticsSummary}" Width="230" MinWidth="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Visibility="{Binding GooseNoStreamsVisibility}" Background="#FAFCFF" BorderBrush="#DCE6F3" BorderThickness="1"
                                        CornerRadius="12" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                    <StackPanel>
                                        <TextBlock Text="No GOOSE traffic" FontSize="13.2" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Choose an adapter and press Start." FontSize="10.8" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource WorkspaceCard}" Padding="9" Height="280"
                            Visibility="{Binding GooseDataSetInspectorVisibility}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DataSet values" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="{Binding GooseSelectedStreamText}" FontSize="10.4" Foreground="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EEF4FF" BorderBrush="#C9D9F1" BorderThickness="1" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="allData order" FontSize="9.6" FontWeight="SemiBold" Foreground="#45648E"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding SelectedGooseStream.Leaves}" IsReadOnly="True"
                                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeight="38">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                    <Setter Property="Background" Value="#FFF6D8"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="46"/>
                                        <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="175" MinWidth="130"/>
                                        <DataGridTextColumn Header="Reference" Binding="{Binding SignalReference}" Width="2*" MinWidth="230"/>
                                        <DataGridTemplateColumn Header="Value" Width="1.15*" MinWidth="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" MinWidth="86" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F2F4F7"/>
                                                                <Setter Property="BorderBrush" Value="#D0D5DD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                        <Setter Property="Background" Value="#FFF1C7"/>
                                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Value}" Value="&lt;missing in frame&gt;">
                                                                        <Setter Property="Background" Value="#FFF1F2"/>
                                                                        <Setter Property="BorderBrush" Value="#FDA29B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Foreground="#344054" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="FC" Binding="{Binding FunctionalConstraint}" Width="54"/>
                                        <DataGridTextColumn Header="CDC / type" Binding="{Binding TypeText}" Width="120"/>
                                        <DataGridTextColumn Header="Previous" Binding="{Binding PreviousValue}" Width="140"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding BindingSource}" Width="96"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Visibility="{Binding GooseNoLeafValuesVisibility}" Background="#FAFCFF" BorderBrush="#DCE6F3" BorderThickness="1"
                                        CornerRadius="12" Padding="15" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                    <StackPanel>
                                        <TextBlock Text="Select a stream" FontSize="13.2" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ordered values appear here." FontSize="10.8" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- DIAGNOSTICS -->
            <TabItem Header="Diagnostics">
                <Border Style="{StaticResource WorkspaceCard}" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Diagnostics &amp; Communication Journal" Style="{StaticResource WorkspaceTitle}"/>
                                <TextBlock Text="Protocol and connection journal • WARN and ERROR are called out without tinting the whole row." Style="{StaticResource WorkspaceSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyDiagnosticButton" Content="Copy Diagnostic" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0" ToolTip="Copy app, engine, network, IED-session, TCP-probe, and recent journal details for support analysis"
                                        Click="CopyDiagnostics_Click"/>
                                <Button Content="Clear Log" Style="{StaticResource SoftButton}" Click="ClearDiagnostics_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Logs}" IsReadOnly="True" Style="{StaticResource ModernDataGrid}"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="190"/>
                                <DataGridTemplateColumn Header="Level" Width="90" CellTemplate="{StaticResource DiagnosticLevelBadgeTemplate}"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="145"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- FAT: permanent seventh Engineering workspace host. Production presentation is mounted here. -->
            <TabItem x:Name="NativeFatTab" Header="FAT">
                <Grid/>
            </TabItem>
            <!-- Read-only engineering workspace: one virtual tree and one detail viewport. -->
            <TabItem x:Name="IedBrowserTab" Header="IED Browser">
                <TabItem.Resources>
                    <DataTemplate x:Key="BrowserSectionRow">
                        <Border Background="#E8EDF4" BorderBrush="#D4DCE6" BorderThickness="0,1,0,1" Padding="7,3">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left" Tag="{Binding}"
                                        Content="{Binding ToggleGlyph}" Visibility="{Binding ChevronVisibility}"
                                        Click="IedBrowserDetailToggle_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="18" Height="18" Padding="0" Margin="0,0,3,0"
                                        Focusable="False" FontSize="11.5"
                                        ToolTip="Collapse or expand this section"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"
                                           Foreground="#2D4056" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserPropertyRow">
                        <Grid MinHeight="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="158"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F2F5F8" BorderBrush="#E3E8EF" BorderThickness="0,0,1,1" Padding="7,3">
                                <TextBlock Text="{Binding Name}" FontSize="11.2"
                                           Foreground="#48586B" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontSize="11.2"
                                               Foreground="#24364B" TextTrimming="CharacterEllipsis"/>
                                    <Path Data="{StaticResource InvalidQualityWarningGeometry}" Width="12" Height="12"
                                              Stretch="Uniform" Fill="#B97800" Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource InvalidQualityWarningIconStyle}"
                                              ToolTip="IED-reported quality validity: Invalid"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserDataHeaderRow">
                        <Grid MinHeight="24" Background="#EFF3F8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" MinWidth="240" MaxWidth="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Margin="8,3" FontSize="11" FontWeight="SemiBold" Foreground="#3B526B"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="8,3" FontSize="11"
                                       FontWeight="SemiBold" Foreground="#3B526B"/>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserDataRow">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" MinWidth="240" MaxWidth="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#E4EAF2" BorderThickness="0,0,1,1" Padding="5,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{Binding IndentWidth}"/>
                                    <Button Tag="{Binding}" Content="{Binding ToggleGlyph}"
                                            Visibility="{Binding ChevronVisibility}"
                                            Click="IedBrowserDetailToggle_Click"
                                            Background="Transparent" BorderThickness="0"
                                            Width="17" Height="19" Padding="0"
                                            Focusable="False" FontSize="11.5" ToolTip="Expand / collapse"/>
                                    <TextBlock Text="{Binding Glyph}" FontSize="9.5"
                                               Foreground="#2875B9" Margin="1,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11.2"
                                               TextTrimming="CharacterEllipsis" Foreground="#283F58"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#E4EAF2" BorderThickness="0,0,0,1" Padding="8,2">
                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                                    <!-- Channel label is shown only for a real Report/Read
                                         observation; engineering schema alone cannot color
                                         an unevaluated signal as measured/healthy. -->
                                    <TextBlock Grid.Column="1" Text="{Binding ObservationSource}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               FontSize="9.8"
                                               Foreground="#4B6B94" Margin="10,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ObservationSource}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}"
                                                   FontSize="11.2" Foreground="#344860"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Path Data="{StaticResource InvalidQualityWarningGeometry}" Width="12" Height="12"
                                              Stretch="Uniform" Fill="#B97800" Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource InvalidQualityWarningIconStyle}"
                                              ToolTip="IED-reported quality validity: Invalid"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserMessageRow">
                        <Border Padding="8,7" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding Name}" Foreground="#697C90" FontSize="11.2"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserFlagGroupRow">
                        <Border Padding="7,5" BorderBrush="#DCE4EF" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}" IsThreeState="True"
                                                  IsHitTestVisible="False" Focusable="False"
                                                  ToolTip="{Binding Status}" Margin="2,2,19,4"
                                                  FontSize="11.2" Foreground="#344860"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="BrowserObjectRow">
                        <Border MinHeight="23" BorderBrush="#E0E7EF" BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <Grid Margin="7,1,7,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding GlyphBrush}" CornerRadius="2"
                                        Height="16" Width="23" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontSize="9" Foreground="White"
                                               FontWeight="SemiBold" TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11.2" Foreground="#273C55"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryText}" FontSize="10"
                                               Foreground="#718398" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SecondaryText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" ToolTip="{Binding Value}"
                                           FontSize="10.5" Foreground="#63768A" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <!-- Only RCB rows have a compact fixed name/icon slot. -->
                    <DataTemplate x:Key="BrowserRcbObjectRow">
                        <Border MinHeight="23" BorderBrush="#E0E7EF" BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <Grid Margin="7,1,7,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding GlyphBrush}"
                                        CornerRadius="2" Height="16" Width="23"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontSize="9"
                                               Foreground="White" FontWeight="SemiBold"
                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           ToolTip="{Binding Name}" FontSize="11.2"
                                           Foreground="#273C55" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Path Grid.Column="2" Data="{StaticResource BrowserRcbEnabledIconGeometry}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="#277455" VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding RcbEnabledVisibility}"
                                      ToolTip="{Binding RcbEnabledTooltip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <Style x:Key="BrowserDetailContentStyle" TargetType="ContentControl">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="ContentTemplate" Value="{StaticResource BrowserPropertyRow}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Section">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserSectionRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="DataHeader">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserDataHeaderRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Data">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserDataRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Message">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserMessageRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Object">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserObjectRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NavigateTo.Kind}" Value="RCB">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserRcbObjectRow}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="FlagGroup">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrowserFlagGroupRow}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Resources>
                <Border Style="{StaticResource WorkspaceCard}" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="IED Browser" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="IedBrowserSubtitle" Text="Select an IED to inspect cached model information."
                                           FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh view" Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        Click="IedBrowserRefresh_Click"
                                        ToolTip="Rebuild view from cached SCL/discovery only; does not contact the IED"/>
                                <Button x:Name="IedBrowserControlButton" Content="Control…"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        IsEnabled="False" Click="IedBrowserControl_Click"
                                        ToolTip="Only enabled when this online DO has an existing live-verified native IEC Control descriptor."/>
                                <Button x:Name="IedBrowserWriteButton"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        MinWidth="79" IsEnabled="False" Click="IedBrowserWrite_Click"
                                        ToolTip="Write the selected live Data Attribute or the exact DO after verification.">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" Margin="0,0,5,0" IsHitTestVisible="False">
                                            <Path Data="M167-120q-21 5-36.5-10.5T120-167l40-191 198 198-191 40Zm191-40L160-358l458-458q23-23 57-23t57 23l84 84q23 23 23 57t-23 57L358-160Zm317-600L261-346l85 85 414-414-85-85Z"
                                                  Fill="#365A82"/>
                                        </Viewbox>
                                        <TextBlock Text="Write" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="IedBrowserReadPageButton" Content="Read" Tag="Page"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        Click="IedBrowserReadValues_Click"
                                        ToolTip="Read values for the current Browser object over MMS. Live monitoring uses the report stream."/>
                                <Button x:Name="IedBrowserReadLnButton" Content="Read LN" Tag="LN"
                                        Visibility="Collapsed" Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        Click="IedBrowserReadValues_Click"
                                        ToolTip="Read all model-proven attributes in this LN, not just the focused Data Object."/>
                                <Button x:Name="IedBrowserReadAllButton" Content="Read All" Tag="All"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        Click="IedBrowserReadValues_Click"
                                        ToolTip="Read model-proven IEC data attributes sequentially; progress appears on the IED card."/>
                                <ComboBox x:Name="IedBrowserGooseAdapterCombo"
                                          Width="195" Height="30" Margin="0,0,5,0"
                                          ItemsSource="{Binding GooseAdapters}"
                                          SelectedItem="{Binding SelectedGooseAdapter, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText" Visibility="Collapsed"
                                          ToolTip="Station Ethernet capture adapter. Choosing an adapter never starts capture automatically."/>
                                <Button x:Name="IedBrowserGooseStopButton" Content="Stop GOOSE"
                                        Style="{StaticResource SoftButton}" Margin="0,0,5,0"
                                        Visibility="Collapsed" Click="IedBrowserGooseStop_Click"
                                        ToolTip="Stop the existing passive GOOSE subscriber; no MMS writes."/>
                                <Button x:Name="IedBrowserGooseSubscribeButton" Content="Subscribe GOOSE"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        Visibility="Collapsed" Click="IedBrowserGooseSubscribe_Click"
                                        ToolTip="Start or inspect the existing read-only subscriber here in IED Browser, without switching workspace or writing MMS."/>
                                <Button x:Name="IedBrowserCancelReadButton" Content="Cancel Read"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        IsEnabled="False" Click="IedBrowserCancelRead_Click"
                                        ToolTip="Cancel the active read-only MMS sweep"/>
                                <Button Content="Browse Files" Click="IedBrowserBrowseFiles_Click"
                                        Style="{StaticResource SoftButton}" Margin="0,0,6,0"
                                        ToolTip="Refresh remote COMTRADE fault-record files through IEC 61850 FileDirectory"/>
                                <Button x:Name="IedBrowserReadRcbButton" Content="Check live RCB" Style="{StaticResource SoftButton}"
                                        Margin="0,0,6,0" Click="IedBrowserReadRcb_Click"
                                        ToolTip="Explicit read-only availability check; does not enable reporting"/>
                                <Button x:Name="IedBrowserExportReadEvidenceButton" Content="Read evidence…" Style="{StaticResource SoftButton}"
                                        Margin="0,0,6,0" Click="IedBrowserExportReadEvidence_Click"
                                        ToolTip="Save exact IEC reference/FC, canonical observations, failures and deferred coverage as CSV; no MMS operation"/>
                                <Button x:Name="IedBrowserExportRcbButton" Content="Export RCB…" Style="{StaticResource SoftButton}"
                                        Click="IedBrowserExportRcb_Click" ToolTip="Open the existing RCB export workflow"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="285" MinWidth="240"/>
                                <!-- Eight-pixel native resize hitbox, visually only one pixel idle. -->
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*" MinWidth="400"/>
                            </Grid.ColumnDefinitions>
                            <!-- A flat, row-virtualized DataGrid behaves as a hierarchical TreeGrid. -->
                            <Grid Grid.Column="0">
                                <!-- Selection belongs exclusively to the outer IED Explorer. -->
                                <DataGrid x:Name="IedBrowserTreeGrid"
                                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          BorderBrush="#D5DEE9" BorderThickness="1" RowHeaderWidth="0"
                                          FontSize="11.2" RowHeight="24" ColumnHeaderHeight="24"
                                          Background="#F9FBFE" AlternatingRowBackground="#F0F4F9"
                                          CanUserSortColumns="False" CanUserResizeColumns="False"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          SelectionChanged="IedBrowserTree_SelectionChanged">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                                         Handler="IedBrowserTreeRow_MouseUp"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <!-- Keep the browsing location visible even when
                                                 keyboard focus moves into the detail panel. -->
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#C7E1FF"/>
                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="#17365B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                    <Setter Property="Background" Value="#C7E1FF"/>
                                                    <Setter Property="Foreground" Value="#17365B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Objects" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="17"/>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="{Binding IndentWidth}"/>
                                                        <Button Grid.Column="1" Tag="{Binding}" Content="{Binding ToggleGlyph}"
                                                                Visibility="{Binding ChevronVisibility}"
                                                                Click="IedBrowserTreeToggle_Click"
                                                                Background="Transparent" BorderThickness="0"
                                                                Width="17" Height="21" FontSize="12" Padding="0"
                                                                Focusable="False" ToolTip="Expand or collapse"/>
                                                        <Border Grid.Column="2" Background="{Binding GlyphBrush}"
                                                                CornerRadius="2" Padding="2,0" Height="16"
                                                                VerticalAlignment="Center" Margin="3,0,5,0">
                                                            <TextBlock Text="{Binding Glyph}" Foreground="White"
                                                                       FontSize="9" FontWeight="SemiBold"
                                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="#243B54" VerticalAlignment="Center"/>
                                                        <Path Grid.Column="4" Data="{StaticResource BrowserRcbEnabledIconGeometry}"
                                                              Width="15" Height="15" Stretch="Uniform"
                                                              Fill="#277455" VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"
                                                              Visibility="{Binding RcbEnabledVisibility}"
                                                              ToolTip="{Binding RcbEnabledTooltip}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <!-- Keep GridSplitter as a DIRECT child of the resized Grid.
                                 The non-hit-test overlay draws its grip without narrowing
                                 the native drag target or changing panel resize semantics. -->
                            <GridSplitter Grid.Column="1" x:Name="IedBrowserPaneSplitter" Width="8"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" ShowsPreview="True"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                          ToolTip="Drag to resize Browser panels"/>
                            <Border Grid.Column="1" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="#C5CFD9"/>
                                        <Setter Property="Width" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=IedBrowserPaneSplitter}" Value="True">
                                                <Setter Property="Background" Value="#17212F"/>
                                                <Setter Property="Width" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#E8EFF7" BorderBrush="#CBD7E4"
                                        BorderThickness="1,1,1,0" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="IedBrowserBackButton" Grid.Column="0" Content="← Back"
                                                IsEnabled="False" Click="IedBrowserBack_Click"
                                                Style="{StaticResource SoftButton}" Margin="0,0,8,0"
                                                Padding="6,2" FontSize="11"
                                                ToolTip="Return to the previous Browser folder"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="IedBrowserObjectPath" Text="Select an object in the left tree"
                                                       FontSize="11.2" FontWeight="SemiBold" Foreground="#2B405A"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="IedBrowserDetailStatus" Text="Cached engineering model · read-only navigation"
                                                       FontSize="10" Foreground="#62758A"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                <ListView x:Name="IedBrowserDetailList"
                                          SelectionChanged="IedBrowserDetailList_SelectionChanged"
                                          SelectionMode="Single"
                                          ClipToBounds="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          AlternationCount="2"
                                          BorderBrush="#CBD7E4" BorderThickness="1"
                                          Background="White" HorizontalContentAlignment="Stretch"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <EventSetter Event="MouseDoubleClick" Handler="IedBrowserDetailItem_DoubleClick"/>
                                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                                         Handler="IedBrowserDetailRow_MouseUp"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="True"/>
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="SelectionChrome"
                                                                Background="{TemplateBinding Background}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SelectionChrome" Property="Background"
                                                                        Value="#E5F0FB"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SelectionChrome" Property="Background"
                                                                        Value="#C7E1FB"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="#F0F4F9"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Object">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}"
                                                            Style="{StaticResource BrowserDetailContentStyle}"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <!-- Files are a separate dense 3-column virtualized native grid;
                                     normal Browser detail rows remain untouched. -->
                                <Grid x:Name="IedBrowserFilesPanel" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#EDF4FC" BorderBrush="#D6E2F0"
                                            BorderThickness="1,1,1,0" Padding="10,6">
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="IedBrowserFilesDownloadSelectedButton"
                                                    DockPanel.Dock="Right" Content="Download selected"
                                                    Click="IedBrowserDownloadSelected_Click"
                                                    Style="{StaticResource SoftButton}" IsEnabled="False"
                                                    Padding="10,4" Margin="8,0,0,0" FontSize="11"
                                                    ToolTip="Download the selected complete COMTRADE record and open its local folder"/>
                                            <TextBlock x:Name="IedBrowserFileSelectionText"
                                                       Text="Select a file · Double-click to open · Right-click for Download"
                                                       VerticalAlignment="Center" FontSize="11.4"
                                                       Foreground="#475F7A" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                <DataGrid x:Name="IedBrowserFilesGrid" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          SelectionChanged="IedBrowserFiles_SelectionChanged"
                                          HeadersVisibility="Column" AlternationCount="2"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          BorderBrush="#CBD7E4" BorderThickness="1"
                                          Background="White" RowHeight="27" FontSize="11.6"
                                          AlternatingRowBackground="#F0F4F9"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6"
                                          LoadingRow="IedBrowserFile_LoadingRow">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Background" Value="#DDEBF9"/>
                                            <Setter Property="Foreground" Value="#274766"/>
                                            <Setter Property="BorderBrush" Value="#CCDDEE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="7,3"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <EventSetter Event="MouseDoubleClick" Handler="IedBrowserFile_DoubleClick"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="IedBrowserFile_RightClick"/>
                                            <Setter Property="ToolTip" Value="{Binding RemotePath}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="#EDF4FC"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EAF3FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#CFE5FF"/>
                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="#17365B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="7,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#243C57"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                    <Setter Property="Background" Value="#CFE5FF"/>
                                                    <Setter Property="Foreground" Value="#17365B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Filename" Width="*" MinWidth="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Margin="10,0,5,0">
                                                        <!-- Vector geometry supplied for the File List:
                                                             no font icon and no raster dependency. -->
                                                        <!-- Stretch an SVG-space geometry into a real 18px
                                                             WPF Path. The original -960 coordinate system
                                                             must not render outside a 17px Viewbox viewport. -->
                                                        <Path Width="18" Height="18" Margin="0,0,7,0"
                                                              Fill="#2367AD" Stretch="Uniform"
                                                              Data="M824-120 636-308q-41 32-90.5 50T440-240q-90 0-162.5-44T163-400h98q34 37 79.5 58.5T440-320q100 0 170-70t70-170q0-100-70-170t-170-70q-94 0-162.5 63.5T201-580h-80q8-127 99.5-213.5T440-880q134 0 227 93t93 227q0 56-18 105.5T692-364l188 188-56 56ZM397-400l-63-208-52 148H80v-60h160l66-190h60l60 120h30v60h-67l-47-94-50 154h-59Z"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Time" Binding="{Binding ModifiedText}"
                                                            Width="175" MinWidth="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}"
                                                            Width="110" MinWidth="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Grid>
                                <!-- Overlay is scoped to Files only, never to monitoring or
                                     the Explorer. Cancellation reaches the dedicated transfer. -->
                                <Border x:Name="IedBrowserFileTransferOverlay" Visibility="Collapsed"
                                        Background="#D9FFFFFF" Panel.ZIndex="3">
                                    <Border Width="350" MaxWidth="410" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Background="White"
                                            BorderBrush="#CCD8E5" BorderThickness="1"
                                            CornerRadius="10" Padding="17">
                                        <StackPanel>
                                            <TextBlock Text="COMTRADE transfer" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="#223D5E"/>
                                            <TextBlock x:Name="IedBrowserFileTransferText"
                                                       Margin="0,8,0,9" TextWrapping="Wrap"
                                                       FontSize="11" Foreground="#516780"
                                                       Text="Preparing record…"/>
                                            <ProgressBar x:Name="IedBrowserFileTransferProgress"
                                                         Height="5" Minimum="0" Maximum="100"
                                                         IsIndeterminate="True"/>
                                            <Button Content="Cancel" Click="IedBrowserCancelFileTransfer_Click"
                                                    Style="{StaticResource SoftButton}" Margin="0,12,0,0"
                                                    Padding="12,4" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Embedded, wire-first viewer. No selected IED or SCL required. -->
            <TabItem x:Name="SmvWorkspaceTab" Header="SMV">
                <views:SmvInlineViewer x:Name="MainSmvViewer"/>
            </TabItem>
        </TabControl>

        <!-- The status strip must NEVER grow when diagnostics contain newlines or stack traces. -->
        <Border Grid.Row="2" Height="34" MinHeight="34" MaxHeight="34"
                Margin="0,7,0,0" Background="#EAF1FF" BorderBrush="#CFE0FF"
                BorderThickness="1" CornerRadius="8" Padding="10,0" ClipToBounds="True">
            <Grid Height="32" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MinWidth="0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastStatusText}"
                               VerticalAlignment="Center" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource Ink}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="19"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding RuntimeSummaryText}"
                           VerticalAlignment="Center" FontSize="10.5"
                           Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="19"/>
            </Grid>
        </Border>



    </Grid>
</Window>
