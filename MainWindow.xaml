<Window x:Class="ArIED61850Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArIED61850Tester.Views"
        Title="ARSAS - Smart IEC 61850 Communication Tester"
        Height="900" Width="1480" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource AppBackgroundGradient}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Icon="Assets/app-icon.ico" Closing="Window_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- IEC validity attention is display-only; use a single vector and avoid font-dependent emojis. -->
        <GeometryGroup x:Key="InvalidQualityWarningGeometry" FillRule="EvenOdd">
            <PathGeometry Figures="M 40,-120 L 480,-880 920,-120 Z"/>
            <PathGeometry Figures="M 178,-200 L 782,-200 480,-720 Z"/>
            <RectangleGeometry Rect="440,-560,80,200"/>
            <EllipseGeometry Center="480,-280" RadiusX="40" RadiusY="40"/>
        </GeometryGroup>
        <Style x:Key="InvalidQualityWarningIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInvalidQuality}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Exact operator-supplied circular unlocked-padlock vector; no font glyph. -->
        <Geometry x:Key="BrowserRcbEnabledIconGeometry">M380-320h200q25 0 42.5-17.5T640-380v-120q0-25-17.5-42.5T580-560v-60q0-42-29-71t-71-29q-42 0-71 29t-29 71h60q0-17 11.5-28.5T480-660q17 0 28.5 11.5T520-620v60H380q-25 0-42.5 17.5T320-500v120q0 25 17.5 42.5T380-320ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T197-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>
        <!-- Preserve compact columns; hover reveals the complete list of
             distinct active RCB names when more than one reports a signal. -->
        <Style x:Key="RcbAcquisitionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding AcquisitionShort}"/>
        </Style>
        <!-- Process-value family is presentation-only and remains separate from alarm
             severity/quality. A/B/P markers make analog, Boolean and position values
             scannable without relying on color alone. Normal state families avoid red/green
             so availability, success, faults and bad quality keep their existing semantics. -->


        <DataTemplate x:Key="EventQualityBadgeTemplate">
            <Border x:Name="QualityBadge" CornerRadius="8" Padding="7,2" MinWidth="72"
                    HorizontalAlignment="Left" Background="#F3F6F9" BorderBrush="#D5DEE8" BorderThickness="1">
                <TextBlock x:Name="QualityText" Text="{Binding Quality}" FontSize="10.4" FontWeight="SemiBold"
                           Foreground="#617286" TextTrimming="CharacterEllipsis" ToolTip="{Binding Quality}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding QualityTone}" Value="Attention">
                    <Setter TargetName="QualityBadge" Property="Background" Value="#FFF8E6"/>
                    <Setter TargetName="QualityBadge" Property="BorderBrush" Value="#F2D28A"/>
                    <Setter TargetName="QualityText" Property="Foreground" Value="#946200"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityTone}" Value="Bad">
                    <Setter TargetName="QualityBadge" Property="Background" Value="#FFF1F2"/>
                    <Setter TargetName="QualityBadge" Property="BorderBrush" Value="#FDA29B"/>
                    <Setter TargetName="QualityText" Property="Foreground" Value="#B42318"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityTone}" Value="Good">
                    <Setter TargetName="QualityBadge" Property="Background" Value="#F3F6F9"/>
                    <Setter TargetName="QualityBadge" Property="BorderBrush" Value="#D5DEE8"/>
                    <Setter TargetName="QualityText" Property="Foreground" Value="#52677E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticLevelBadgeTemplate">
            <Border x:Name="LevelBadge" CornerRadius="8" Padding="7,2" MinWidth="58"
                    HorizontalAlignment="Left" Background="#EEF4FF" BorderBrush="#C9D9F1" BorderThickness="1">
                <TextBlock x:Name="LevelText" Text="{Binding Level}" FontSize="10.2" FontWeight="Bold" Foreground="#45648E"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter TargetName="LevelBadge" Property="Background" Value="#FFF8E6"/>
                    <Setter TargetName="LevelBadge" Property="BorderBrush" Value="#F2D28A"/>
                    <Setter TargetName="LevelText" Property="Foreground" Value="#946200"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter TargetName="LevelBadge" Property="Background" Value="#FFF1F2"/>
                    <Setter TargetName="LevelBadge" Property="BorderBrush" Value="#FDA29B"/>
                    <Setter TargetName="LevelText" Property="Foreground" Value="#B42318"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact navigation row: the large top application bar is removed to free vertical space. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="WorkflowNavShell" Width="760" Height="56" HorizontalAlignment="Left"
                    Background="#E7ECF5" CornerRadius="14" Padding="5" Effect="{StaticResource SoftShadow}"
                    ClipToBounds="False">
                <Grid x:Name="WorkflowNavGrid" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="WorkflowPill" Grid.ColumnSpan="8" Width="112" Height="34"
                            HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="17"
                            Background="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="WorkflowPillScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="WorkflowPillTranslate" X="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#2563EB"/>
                        </Border.Effect>
                    </Border>
                    <Button x:Name="NavExplorerButton" Grid.Column="1" Tag="1" TabIndex="1" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="Device Explorer">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorIecTopologyIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Device Explorer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSmvButton" Grid.Column="5" Tag="5" TabIndex="5" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="SMV · Sampled Values">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource MaterialLiveIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="SMV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavEventsButton" Grid.Column="2" Tag="2" TabIndex="2" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="Event Logs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorEventLogIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Event Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAlarmButton" Grid.Column="3" Tag="3" TabIndex="3" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="Annunciator">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorAlarmIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Annunciator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavGooseButton" Grid.Column="4" Tag="4" TabIndex="4" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="GOOSE Sniff">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorIecWirelessIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="GOOSE Sniff" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDiagnosticsButton" Grid.Column="7" Tag="7" TabIndex="7" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorDiagnosticsIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding DiagnosticsAlertVisibility}"
                                    Width="17" Height="17" CornerRadius="8.5" Margin="7,0,0,0"
                                    Background="#DC2626" BorderBrush="White" BorderThickness="1.5">
                                <TextBlock Text="!" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavNativeFatButton" Grid.Column="6" Tag="6" TabIndex="6" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="Signal Testing">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorFatIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="Signal Testing" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavIedBrowserButton" Grid.Column="0" Tag="0" TabIndex="0" Click="NavButton_Click" Style="{StaticResource SegmentedNavButton}" ToolTip="IED Browser">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,5,0" IsHitTestVisible="False">
                                <Path Data="{StaticResource OperatorIedBrowserIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="IED Browser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Runtime counts intentionally live only in the bottom status bar.
                 Keeping the header free of duplicate status chips reduces visual noise
                 and reserves width for the six workflow destinations. -->
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0"
                    Style="{StaticResource HiddenTabControl}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <!-- IEC 61850 EXPLORER -->
            <TabItem Header="Device Explorer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="258"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WorkspaceCard}" Padding="10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="IED Explorer" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IedIconButton}" Click="OpenProject_Click" ToolTip="Open ARSAS project" Margin="0,0,6,0">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource MaterialFolderOpenIcon}" Style="{StaticResource MaterialIconGlyph}"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Style="{StaticResource IedIconButton}" Click="SaveProject_Click" ToolTip="Save ARSAS project">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource MaterialSaveIcon}" Style="{StaticResource MaterialIconGlyph}"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Always-visible fast workflow actions. They remain anchored below the
                                 independently scrolling IED list and never move with its content. -->
                            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="5"
                                    Background="#F7FAFF" BorderBrush="#DCE6F5" BorderThickness="1"
                                    CornerRadius="15" Effect="{StaticResource SoftShadow}" Panel.ZIndex="30">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.ColumnSpan="3" Click="ConnectAllIeds_Click"
                                            Style="{StaticResource SoftButton}" Padding="8,7" FontSize="11.5"
                                            ToolTip="Fast-connect every saved or SCL-imported IED and start live monitoring for saved selections">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                                <Path Data="{StaticResource MaterialPlayIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#16A34A"/>
                                            </Viewbox>
                                            <TextBlock Text="Connect All" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="0" Click="OpenScl_Click"
                                            Style="{StaticResource SoftButton}" Padding="7,7" FontSize="11.2"
                                            ToolTip="Import one or more IED endpoints from SCD, CID, ICD, IID, SSD, or XML SCL files">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                                <Path Data="{StaticResource MaterialUploadFileIcon}" Style="{StaticResource MaterialIconGlyph}"/>
                                            </Viewbox>
                                            <TextBlock Text="Open SCL" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="2" Click="AddRelay_Click"
                                            Style="{StaticResource PrimaryButton}" Padding="7,7" FontSize="11.2"
                                            ToolTip="Add an IEC 61850 IED by IP address">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                                <Path Data="{StaticResource OperatorAddIedIcon}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="Add IED" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Card" Background="{StaticResource IedCardSurface}"
                                                            BorderBrush="#CDD9EA" BorderThickness="1" CornerRadius="16" Padding="9">
                                                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.08" Color="#1E3355"/></Border.Effect>
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource IedCardConnected}"/>
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#83C7A1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource IedCardSelected}"/>
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#6F9FF1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource IedCardHover}"/>
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#8EAFE3"/>
                                                        </Trigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMonitoring}" Value="True"/>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource IedCardConnectedSelected}"/>
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#55A77E"/>
                                                        </MultiDataTrigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource IedCardSelected}"/>
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#4F86E5"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="74">
                                            <Grid x:Name="CardContent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Static protection-relay fascia with a dedicated status label below it. -->
                                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="60"
                                                            Margin="-2,0,-2,0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Center" Panel.ZIndex="2">
                                                    <Viewbox Width="50" Height="50" Stretch="Uniform"
                                                             HorizontalAlignment="Center">
                                                        <Control x:Name="RelayDeviceIcon" Width="50" Height="50"
                                                                 Foreground="#EF4444"
                                                                 Template="{StaticResource IedRelayFrontPanelTemplate}"/>
                                                    </Viewbox>
                                                    <Border x:Name="MonitorStateBadge"
                                                            HorizontalAlignment="Center" Margin="0,2,0,0"
                                                            Background="#F5FFF0F1" BorderBrush="#F3A3A8" BorderThickness="1"
                                                            CornerRadius="3" Padding="4,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="MonitorStateDot" Width="3.8" Height="3.8" Fill="#E5484D"
                                                                     Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="MonitorStateText" Text="STOP" FontSize="6.8"
                                                                       FontWeight="SemiBold" Foreground="#C92A32"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

<StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="4,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.8" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Ink}" TextOptions.TextFormattingMode="Ideal" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    <TextBlock Text="{Binding EndpointText}" FontSize="11.1"
                                                               Foreground="{StaticResource Muted}" TextOptions.TextFormattingMode="Ideal" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch"
                                                               ToolTip="{Binding SclEndpointHint}"
                                                               ContextMenuOpening="SclEndpoint_ContextMenuOpening">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu/>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                    <!-- Single permanent 7px slot for explicit discovery/fast-connect
                                                         and Browser Read. Neither activity covers the IED identity
                                                         nor changes card geometry or button positions. -->
                                                    <Grid Height="7" Margin="0,3,0,0"
                                                          VerticalAlignment="Center" ClipToBounds="True">
                                                        <ProgressBar x:Name="BrowserReadProgressLine" Height="3"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding IedCardProgressPercent, Mode=OneWay}"
                                                                     Style="{StaticResource DiscoveryProgressBar}"
                                                                     Opacity="0" VerticalAlignment="Center"
                                                                     ToolTip="{Binding BusyStage}"/>
                                                    </Grid>
                                                </StackPanel>
                                      <!-- Adaptive five-slot action bar. It spans the card and reserves the relay-icon area so Play/Stop never clip. -->
                                      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="62,4,1,0" Panel.ZIndex="10">
                                          <UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch">
                                              <Button Style="{StaticResource IedIconButton}" Width="27" Height="27" Margin="0" Tag="{Binding}" Click="IedPlayAction_Click"
                                                      IsEnabled="{Binding CanPlayAction}" ToolTip="{Binding PlayToolTip}">
                                                  <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialPlayIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#16A34A"/></Viewbox>
                                              </Button>
                                              <Button Style="{StaticResource IedIconButton}" Width="27" Height="27" Margin="0" Tag="{Binding}" Click="IedStopAction_Click"
                                                      IsEnabled="{Binding CanStopAction}" ToolTip="{Binding StopToolTip}">
                                                  <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialStopIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="{StaticResource Warning}"/></Viewbox>
                                              </Button>
                                              <Button Style="{StaticResource IedIconButton}" Width="27" Height="27" Margin="0" Tag="{Binding}" Click="IedConfigureSignals_Click"
                                                      IsEnabled="{Binding CanEditSignals}" ToolTip="{Binding ConfigureToolTip}">
                                                  <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialEditIcon}" Style="{StaticResource MaterialIconGlyph}"/></Viewbox>
                                              </Button>
                                              <Button Style="{StaticResource IedIconButton}" Width="27" Height="27" Margin="0" Tag="{Binding}" Click="IedEditRcb_Click"
                                                      IsEnabled="{Binding IsActionEnabled}" ToolTip="RCB Export Filter — keep one RCB for legacy SAS CID import">
                                                  <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialTuneIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#315DBF"/></Viewbox>
                                              </Button>
                                              <Button Style="{StaticResource IedIconButton}" Width="27" Height="27" Margin="0" Tag="{Binding}" Click="IedSaveScl_Click"
                                                      IsEnabled="{Binding CanSaveScl}" ToolTip="{Binding SaveSclToolTip}">
                                                  <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialSaveIcon}" Style="{StaticResource MaterialIconGlyph}"/></Viewbox>
                                              </Button>
                                          </UniformGrid>
                                      </Grid>
                                            </Grid>

                                            <Button Style="{StaticResource IedIconButton}" Tag="{Binding}" Click="IedRemove_Click"
                                                    IsEnabled="{Binding IsActionEnabled}" ToolTip="{Binding RemoveToolTip}"
                                                    Width="25" Height="25" Margin="0,-4,-4,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="12">
                                                <Viewbox Width="14" Height="14"><Path Data="{StaticResource MaterialCloseIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="{StaticResource Danger}"/></Viewbox>
                                            </Button>

                                            <!-- Discovery reuses the IP progress slot; no masking busy card,
                                                 circular spinner, empty animated card or second progress bar. -->
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter TargetName="RelayDeviceIcon" Property="Foreground" Value="#16A34A"/>
                                                <Setter TargetName="MonitorStateBadge" Property="Background" Value="#E5F7ED"/>
                                                <Setter TargetName="MonitorStateBadge" Property="BorderBrush" Value="#8CCDA8"/>
                                                <Setter TargetName="MonitorStateDot" Property="Fill" Value="{StaticResource Success}"/>
                                                <Setter TargetName="MonitorStateText" Property="Text" Value="LIVE"/>
                                                <Setter TargetName="MonitorStateText" Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                            <!-- Each action retains its own CanPlay/CanStop/IsActionEnabled gate.
                                                 Stop must remain clickable during an in-flight discovery. -->
                                            <DataTrigger Binding="{Binding IsDiscoveryProgressActive}" Value="True">
                                                <Setter TargetName="BrowserReadProgressLine" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBrowserReading}" Value="True">
                                                <!-- Opacity does not affect measure/arrange: zero card jiggle. -->
                                                <Setter TargetName="BrowserReadProgressLine" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <!-- Original premium first-run empty state restored. -->
                        <Border Style="{StaticResource WorkspaceCard}" Padding="0" Visibility="{Binding EmptyExplorerVisibility}" ClipToBounds="True">
                            <Grid>
                                <Image Source="Assets/gateway-hero.png" Stretch="UniformToFill" Opacity="0.88"/>
                                <Rectangle Fill="#F8FAFC" Opacity="0.18"/>
                                <Border Background="#F8FAFC" Opacity="0.91" CornerRadius="22" Padding="22"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34" MaxWidth="535">
                                    <StackPanel>
                                        <TextBlock Text="Start by adding your first IED" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="Connect a relay by IP, let ARSAS discover the live IEC 61850 MMS model, choose only the signals you need, then monitor every IED independently."
                                                   TextWrapping="Wrap" FontSize="13.4" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource SoftButton}" Click="OpenProject_Click" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource MaterialFolderOpenIcon}" Style="{StaticResource MaterialIconGlyph}"/></Viewbox>
                                                    <TextBlock Text="Open Project"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Use the always-visible Add IED action below the Explorer list."
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Visibility="{Binding SelectedExplorerVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition x:Name="ExplorerCommandDockRow" Height="Auto" MinHeight="0"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource WorkspaceCard}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"/>
                                            <TextBlock Text="LIVE SIGNAL VALUES" FontSize="10.5" FontWeight="Bold" Foreground="#536275" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedDevice.Points.Count, StringFormat={}{0} signals}" FontSize="9.8" FontWeight="SemiBold" Foreground="#8B98A8" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="350" Height="34" CornerRadius="9"
                                                Background="#F8FAFC" BorderBrush="#C8D2DE" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource MaterialSearchIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#738398"/>
                                                </Viewbox>
                                                <TextBox x:Name="ExplorerLiveSearchBox" Grid.Column="1"
                                                         BorderThickness="0" Background="Transparent" Foreground="#263445"
                                                         CaretBrush="#2563EB" FontSize="11.5" Padding="0"
                                                         VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"
                                                         TextChanged="ExplorerLiveSearch_TextChanged"
                                                         ToolTip="Filter the selected IED live values without changing the monitored point set."/>
                                                <TextBlock Grid.Column="1" Text="Search signal, IEC reference, value, quality or acquisition"
                                                           Foreground="#8B98A8" FontSize="11.2" VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ExplorerLiveSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="2" Click="ExplorerLiveSearchClear_Click"
                                                        Width="24" Height="24" Padding="0" Margin="0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Clear Live Signal search" FocusVisualStyle="{x:Null}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7">
                                                                            <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource MaterialCloseIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#607086"/>
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7EEF7"/></Trigger>
                                                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCE7F5"/></Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ExplorerLiveSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DataGrid x:Name="ExplorerLiveValuesGrid" Grid.Row="2" ItemsSource="{Binding SelectedDevice.Points}" IsReadOnly="True"
                                              Loaded="ExplorerLiveGrid_Loaded"
                                              Style="{StaticResource ModernDataGrid}" FrozenColumnCount="2"
                                              MinHeight="0" VerticalAlignment="Stretch"
                                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentlyChanged}" Value="True">
                                                        <Setter Property="Background" Value="#FFF0A8"/>
                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                        <Setter Property="BorderThickness" Value="4,1,1,1"/>
                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                        <Setter Property="Opacity" Value="0.56"/>
                                                        <Setter Property="Background" Value="#F0F3F6"/>
                                                        <Setter Property="ToolTip" Value="{Binding Status}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentlyChanged}" Value="True">
                                                        <Setter Property="Background" Value="#FFF5C2"/>
                                                        <Setter Property="Foreground" Value="#5C3B00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Signal" Binding="{Binding ExplorerSignalName}" Width="1.05*" MinWidth="145"/>
                                            <DataGridTextColumn Header="IEC Telegram" Binding="{Binding IecTelegram}" Width="1.55*" MinWidth="205"/>
                                            <DataGridTemplateColumn Header="Value" Width="0.8*" MinWidth="125" CellTemplate="{StaticResource ProcessValueBadgeTemplate}"/>
                                            <DataGridTemplateColumn Header="Alarm" Width="72" MinWidth="68">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsAnnunciatorSelected, Mode=OneWay}"
                                                                  IsEnabled="{Binding CanUseAsAnnunciator}"
                                                                  Tag="{Binding}" Click="AnnunciatorSelection_Click"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="{Binding AnnunciatorSelectionToolTip}"
                                                                  FocusVisualStyle="{x:Null}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Quality" Width="0.72*" MinWidth="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quality}" ToolTip="{Binding Quality}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Path Data="{StaticResource InvalidQualityWarningGeometry}" Width="12" Height="12"
                                              Stretch="Uniform" Fill="#B97800" Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource InvalidQualityWarningIconStyle}"
                                              ToolTip="IED-reported quality validity: Invalid"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="IED Timestamp" Binding="{Binding DeviceTimestamp}" Width="1.05*" MinWidth="155"/>
                                            <DataGridTextColumn Header="Acquisition" Binding="{Binding AcquisitionShort}" IsReadOnly="True" ElementStyle="{StaticResource RcbAcquisitionTextStyle}" Width="1.05*" MinWidth="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Presentation only; Play/Stop on the IED card owns lifecycle. -->
                                    <Border Grid.Row="2" Visibility="{Binding SelectedDeviceNoLivePointsVisibility}"
                                            Background="#F7F9FC" CornerRadius="10"
                                            BorderBrush="#DBE2EA" BorderThickness="1" Padding="16,10"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                            IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="○" FontSize="14" Foreground="#8292A4" Margin="0,0,8,0"/>
                                            <TextBlock Text="Offline · Press Play on the IED card"
                                                       Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Expander x:Name="CommandPanelExpander" Grid.Row="1" Margin="0,10,0,0" IsExpanded="False"
                                      Style="{StaticResource CommandDockTransparentHeaderExpander}"
                                      VerticalAlignment="Stretch" Expanded="CommandPanel_Expanded" Collapsed="CommandPanel_Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Power is header iconography, not a second control or a raised card.
                                             The entire transparent header remains the one keyboard/mouse toggle. -->
                                        <Viewbox Width="19" Height="19" Margin="0,0,7,0"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource OperatorCommandDockPowerIcon}"
                                                  Fill="White" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="IED Command Panel" FontSize="13.6" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Border Style="{StaticResource WorkspaceCard}" Background="{StaticResource CommandPanelSurface}" Padding="6" BorderBrush="#BFD0E5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <DataGrid x:Name="EquipmentCommandGrid" ItemsSource="{Binding SelectedDevice.CommandSignals}" Loaded="CommandGrid_Loaded" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      Style="{StaticResource CommandDataGrid}" RowStyle="{StaticResource CommandDataGridRow}"
                                                      CellStyle="{StaticResource CommandDataGridCell}" ColumnHeaderStyle="{StaticResource CommandDataGridHeader}"
                                                      AutoGenerateColumns="False" MinHeight="56" RowHeight="43" MinRowHeight="42" ColumnHeaderHeight="35" FrozenColumnCount="1"
                                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      CanUserResizeColumns="False" ClipToBounds="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="IEC Telegram" Binding="{Binding DisplayReference}" Width="1.5*" MinWidth="165" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Control role" Binding="{Binding ControlDockRole}" Width="1.05*" MinWidth="143" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                <Setter Property="ToolTip" Value="Presentation class only. Live typed MMS model decides Operate eligibility; CSWI/CILO/XCBR physical relationships are never guessed."/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="Value" Width="0.93*" MinWidth="137">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <!-- Reuse the process badge; control model/command value is untouched. -->
                                                                <ContentControl Content="{Binding ControlProcessValue}"
                                                                                ContentTemplate="{StaticResource ProcessValueBadgeTemplate}"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                Padding="0" BorderThickness="0" Background="Transparent"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="CDC / Type" Binding="{Binding ControlCdc}" Width="0.7*" MinWidth="74" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Control model" Binding="{Binding ControlModelText}" Width="1.15*" MinWidth="130" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="ToolTip" Value="{Binding ControlInspectionEvidence}"/>
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="Checks" Width="1.22*" MinWidth="165">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                                                    <CheckBox Content="Interlock" FontSize="11.6"
                                                                              IsChecked="{Binding ControlInterlockCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Margin="0,0,10,0"
                                                                              ToolTip="Set the IEC 61850 interlock check flag for this signal only."/>
                                                                    <CheckBox Content="Sync" FontSize="11.6"
                                                                              IsChecked="{Binding ControlSynchroCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Margin="0,0,10,0"
                                                                              ToolTip="Set the IEC 61850 synchrocheck flag for this signal only."/>
                                                                    <CheckBox Content="Test" FontSize="11.6"
                                                                              IsChecked="{Binding ControlTestMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              ToolTip="Send this signal in IEC 61850 Test mode."/>
                                                                </WrapPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Control" Width="1.55*" MinWidth="260">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding IsPositionControl}" Value="True"/>
                                                                                                <Condition Binding="{Binding ControlConfirmationPending}" Value="False"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="Open" Tag="{Binding}" CommandParameter="Open [01]" Click="ControlStageAction_Click"
                                                                                    Style="{StaticResource CommandOpenButton}" Margin="0,0,7,0"
                                                                                    Width="72" MinWidth="72" HorizontalAlignment="Left" IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                            <Button Content="Close" Tag="{Binding}" CommandParameter="Closed [10]" Click="ControlStageAction_Click"
                                                                                    Style="{StaticResource CommandCloseButton}" Margin="0,0,7,0"
                                                                                    Width="72" MinWidth="72" HorizontalAlignment="Left" IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ControlConfirmationPending}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="{Binding ControlPendingConfirmationLabel}" Tag="{Binding}" Click="ControlConfirmAction_Click"
                                                                                    Style="{StaticResource CommandConfirmButton}"
                                                                                    Width="108" MinWidth="108" HorizontalAlignment="Left" IsEnabled="{Binding ControlCanConfirm}" Margin="0,0,7,0" Height="29" MinHeight="29" Padding="10,3"/>
                                                                            <Button Content="Cancel" Tag="{Binding}" Click="ControlCancelAction_Click"
                                                                                    Style="{StaticResource CommandDockSoftButton}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRaiseOnlyControl}" Value="True"/><Condition Binding="{Binding ControlConfirmationPending}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="Raise" Tag="{Binding}" CommandParameter="Raise" Click="ControlStageAction_Click" Style="{StaticResource CommandRaiseButton}"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLowerOnlyControl}" Value="True"/><Condition Binding="{Binding ControlConfirmationPending}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="Lower" Tag="{Binding}" CommandParameter="Lower" Click="ControlStageAction_Click" Style="{StaticResource CommandLowerButton}"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRaiseLowerControl}" Value="True"/><Condition Binding="{Binding ControlConfirmationPending}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="Raise" Tag="{Binding}" CommandParameter="Raise" Click="ControlStageAction_Click" Style="{StaticResource CommandRaiseButton}" Margin="0,0,7,0"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                            <Button Content="Lower" Tag="{Binding}" CommandParameter="Lower" Click="ControlStageAction_Click" Style="{StaticResource CommandLowerButton}"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsBooleanControl}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <Button Content="True" Tag="{Binding}" CommandParameter="True" Click="ControlQuickAction_Click" Style="{StaticResource CommandCloseButton}" Margin="0,0,7,0"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                            <Button Content="False" Tag="{Binding}" CommandParameter="False" Click="ControlQuickAction_Click" Style="{StaticResource CommandOpenButton}"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsSetPointControl}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <TextBox Text="{Binding ControlSetPointText, UpdateSourceTrigger=PropertyChanged}" Width="105" Height="31" Padding="8,4" Margin="0,0,7,0" ToolTip="Target value"/>
                                                                            <Button Content="Set" Tag="{Binding}" Click="ControlQuickAction_Click" Style="{StaticResource CommandDockPrimaryButton}"
                                                                                    IsEnabled="{Binding ControlSupportsOperate}" Height="29" MinHeight="29" Padding="10,3"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="ctlModel" Tag="{Binding}" Click="ControlDetails_Click"
                                                                                IsEnabled="{Binding DataContext.SelectedDevice.IsConnected, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                Style="{StaticResource CommandDockCtlModelButton}" Margin="6,0,1,0"
                                                                                Height="29" MinHeight="29"/>
                                                                        <!-- Unknown/unsupported CDC never produces an empty action cell. -->
                                                                        <TextBlock Text="No typed action" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsGenericControl}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Border Background="#F8FBFF" BorderBrush="#C9D8EB" BorderThickness="1" CornerRadius="13" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.OperableCommandSignals.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="No selected control objects" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- P10.9X error-only toast. Local to Command Dock so
                                             feedback appears beside the operator's action.
                                             No layout shift, focus capture or modal UI. -->
                                        <Border x:Name="ControlShoutCard" Grid.RowSpan="2"
                                                Panel.ZIndex="90" Visibility="Collapsed"
                                                IsHitTestVisible="False" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" MaxWidth="338"
                                                Padding="12,8" CornerRadius="10"
                                                Background="#FFFFFF" BorderBrush="#E5BA82"
                                                BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="2"
                                                                  Opacity="0.15" Color="#243649"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="ControlShoutGlyphBackdrop" Width="22" Height="22"
                                                        CornerRadius="7" Background="#FFF3E2"
                                                        VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <TextBlock x:Name="ControlShoutGlyph" Text="!"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#996219"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="ControlShoutTitle"
                                                           Text="Command not sent" FontSize="12.4"
                                                           FontWeight="SemiBold" Foreground="#76501B"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" MaxWidth="277"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Expander>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- GLOBAL MULTI-IED LIVE MONITOR -->
            <TabItem Header="Internal Live Monitor" Visibility="Collapsed" IsEnabled="False">
                <Border Style="{StaticResource WorkspaceCard}" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Global Multi-IED Live Monitor" Style="{StaticResource WorkspaceTitle}"/>
                                <TextBlock Text="Live values across all monitored IEDs." Style="{StaticResource WorkspaceSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SearchSurface}" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource MaterialSearchIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#607086"/>
                                        </Viewbox>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="GlobalLiveSearchBox"
                                                     TextChanged="GlobalLiveSearch_TextChanged"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     VerticalContentAlignment="Center" FontSize="12"
                                                     Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                                                     ToolTip="Fast search across all monitored IED signals"/>
                                            <TextBlock Text="Search IED, signal, IEC reference, value, quality or acquisition"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Foreground="#98A2B3">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Setter Property="Foreground" Value="#98A2B3"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=GlobalLiveSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" Click="GlobalLiveSearchClear_Click" Background="Transparent"
                                                BorderThickness="0" Padding="7" Cursor="Hand" ToolTip="Clear search" FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=GlobalLiveSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="13" Height="13"><Path Data="{StaticResource MaterialCloseIcon}" Style="{StaticResource MaterialIconGlyph}" Fill="#607086"/></Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Button x:Name="GlobalLiveFiltersButton" Grid.Column="2"
                                        Click="GlobalLiveFilters_Click" Style="{StaticResource SoftButton}"
                                        Padding="10,6" MinHeight="36" ToolTip="Show or hide per-column filters">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                            <Path Data="{StaticResource MaterialTuneIcon}" Style="{StaticResource MaterialIconGlyph}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="GlobalLiveFiltersLabel" Text="Filters" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <DataGrid x:Name="GlobalLiveGrid" ItemsSource="{Binding GlobalPoints}" Loaded="GlobalLiveGrid_Loaded" IsReadOnly="True" Style="{StaticResource ModernDataGrid}"
                                  FrozenColumnCount="3" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecentlyChanged}" Value="True">
                                            <Setter Property="Background" Value="#FFF0A8"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="4,1,1,1"/>
                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                        <Setter Property="Opacity" Value="0.56"/>
                                                        <Setter Property="Background" Value="#F0F3F6"/>
                                                        <Setter Property="ToolTip" Value="{Binding Status}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecentlyChanged}" Value="True">
                                            <Setter Property="Background" Value="#FFF5C2"/>
                                            <Setter Property="Foreground" Value="#5C3B00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IED" Binding="{Binding DeviceName}" Width="120"/>
                                <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="195"/>
                                <DataGridTextColumn Header="IEC Telegram" Binding="{Binding IecTelegram}" Width="320"/>
                                <DataGridTemplateColumn Header="Value" Width="125" CellTemplate="{StaticResource ProcessValueBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="Quality" Width="155">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quality}" ToolTip="{Binding Quality}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Path Data="{StaticResource InvalidQualityWarningGeometry}" Width="12" Height="12"
                                              Stretch="Uniform" Fill="#B97800" Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource InvalidQualityWarningIconStyle}"
                                              ToolTip="IED-reported quality validity: Invalid"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IED Timestamp" Binding="{Binding DeviceTimestamp}" Width="185"/>
                                <DataGridTextColumn Header="Acquisition" Binding="{Binding AcquisitionShort}" IsReadOnly="True" ElementStyle="{StaticResource RcbAcquisitionTextStyle}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- EVENT LOG -->
            <TabItem Header="Event Log">
                <Border Style="{StaticResource WorkspaceCard}" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IEC 61850 Sequence of Events" Style="{StaticResource WorkspaceTitle}"/>
                                <TextBlock Text="SOE edges • process state and signal quality are shown separately." Style="{StaticResource WorkspaceSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1">
                                <Button Content="Export CSV" Style="{StaticResource SoftButton}" Click="ExportEvents_Click" Margin="0,0,8,0"/>
                                <Button Content="Clear" Style="{StaticResource SoftButton}" Click="ClearEvents_Click"/>
                            </WrapPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="EventDrawerColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                        <DataGrid x:Name="EventLogGrid" Grid.Column="0" ItemsSource="{Binding Events}"
                                  SelectionChanged="EventLogGrid_SelectionChanged"
                                  PreviewKeyDown="EventLogGrid_PreviewKeyDown"
                                  IsReadOnly="True" Style="{StaticResource ModernDataGrid}"
                                  FrozenColumnCount="4" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55"/>
                                <DataGridTextColumn Header="IED Timestamp" Binding="{Binding DeviceTimestamp}" Width="177"/>
                                <DataGridTextColumn Header="IED" Binding="{Binding DeviceName}" Width="105"/>
                                <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="155"/>
                                <DataGridTextColumn Header="IEC Telegram" Binding="{Binding IecTelegram}" Width="260"/>
                                <DataGridTemplateColumn Header="Value" Width="130" CellTemplate="{StaticResource ProcessValueBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="Quality" Width="110" CellTemplate="{StaticResource EventQualityBadgeTemplate}"/>
                                <DataGridTextColumn Header="Event" Binding="{Binding EventCause}" Width="124" MinWidth="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Acquisition" Binding="{Binding AcquisitionShort}" ElementStyle="{StaticResource RcbAcquisitionTextStyle}" Width="*" MinWidth="145" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EventDetailsDrawer" Grid.Column="1" Visibility="Collapsed"
                                Background="#FFFFFF" BorderBrush="#DAE4EF" BorderThickness="1"
                                CornerRadius="8" Margin="10,0,0,0" Padding="10"
                                MouseEnter="EventDetailsDrawer_MouseEnter"
                                MouseLeave="EventDetailsDrawer_MouseLeave">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Event details" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock x:Name="EventDetailsSubtitle" FontSize="10.5"
                                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="×" Width="27" Height="27" ToolTip="Close details"
                                            Style="{StaticResource SoftButton}" Click="EventDetailsClose_Click"/>
                                </Grid>
                                <DataGrid x:Name="EventDetailsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False"
                                          CanUserDeleteRows="False" FontSize="10.8" RowHeight="31"
                                          GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="125"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- EVENT-LATCHED ALARM ANNUNCIATOR -->
            <TabItem Header="Alarm Annunciator">
                <Border Style="{StaticResource WorkspaceCard}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#FFF0F0" BorderBrush="#F5B8B8" BorderThickness="1" Margin="0,0,10,0">
                                    <Ellipse Width="12" Height="12" Fill="#DC2626"
                                             Opacity="{Binding AnnunciatorBeaconOpacity}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Alarm Annunciator" Style="{StaticResource WorkspaceTitle}"/>
                                    <TextBlock Text="Unacknowledged flashes • acknowledged steady • returned awaits ACK"
                                               Style="{StaticResource Caption}" Foreground="#667085" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="10,6">
                                <TextBlock Text="{Binding AnnunciatorSummaryText}" FontSize="10.8" FontWeight="SemiBold" Foreground="#475467"/>
                            </Border>
                        </Grid>

                        <!-- IED-first annunciator: the rail scales to hundreds of configured
                             devices while only the selected IED's fascia windows are rendered. -->
                        <Border Grid.Row="2" Background="#292E35" BorderBrush="#1E242B" BorderThickness="1"
                                CornerRadius="16" Padding="10">
                            <Grid>
                                <Border Visibility="{Binding AnnunciatorEmptyVisibility}" Background="#343A43" BorderBrush="#4A535F"
                                        BorderThickness="1" CornerRadius="14" Padding="34"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                                    <StackPanel>
                                        <Ellipse Width="16" Height="16" Fill="#68727E" Stroke="#EEF2F6" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No annunciator IED configured" FontSize="17" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBlock Text="Select Alarm in IEC 61850 Explorer for the ST points that must latch on SOE events."
                                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5" Foreground="#B8C2CF" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Visibility="{Binding AnnunciatorContentVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="222"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Stable IED rail. Do not auto-sort on alarm state: preserving
                                         position lets an operator build spatial memory across a large SAS. -->
                                    <Border Grid.Column="0" Background="#23282F" BorderBrush="#414A55" BorderThickness="1" CornerRadius="12" Padding="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="7"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="IEDs" FontSize="10.8" FontWeight="SemiBold" Foreground="#DCE3EC"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AnnunciatorDeviceCount}" FontSize="11" FontWeight="Bold" Foreground="#AFC2DA" VerticalAlignment="Center"/>
                                            </Grid>

                                            <ListBox Grid.Row="2" ItemsSource="{Binding AnnunciatorDevices}"
                                                     SelectedItem="{Binding SelectedAnnunciatorDevice, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="IedAlarmRailItem" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="9" Padding="2">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="IedAlarmRailItem" Property="Background" Value="#303843"/>
                                                                            <Setter TargetName="IedAlarmRailItem" Property="BorderBrush" Value="#596675"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="IedAlarmRailItem" Property="Background" Value="#2D3948"/>
                                                                            <Setter TargetName="IedAlarmRailItem" Property="BorderBrush" Value="#6EA8FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="54" CornerRadius="7" Padding="7,5" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#2D333B"/>
                                                                    <Setter Property="BorderBrush" Value="#414A55"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding VisualState}" Value="Unacknowledged">
                                                                            <Setter Property="Background" Value="#3B292E"/>
                                                                            <Setter Property="BorderBrush" Value="#8D4650"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding VisualState}" Value="Active">
                                                                            <Setter Property="Background" Value="#3A3129"/>
                                                                            <Setter Property="BorderBrush" Value="#84603C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <Ellipse Width="19" Height="19" Stroke="#F8FAFC" StrokeThickness="1.3"
                                                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                         Opacity="{Binding LampOpacity}">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#66717D"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding VisualState}" Value="Unacknowledged"><Setter Property="Fill" Value="#EF233C"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding VisualState}" Value="Active"><Setter Property="Fill" Value="#F97316"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DeviceName}" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FA"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#8E9BAA"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding VisualState}" Value="Unacknowledged"><Setter Property="Foreground" Value="#FF9AA5"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding VisualState}" Value="Active"><Setter Property="Foreground" Value="#FFB47B"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <!-- Selected IED fascia. Alarm windows fill top-to-bottom first,
                                         then wrap into the next column to match relay LED-list reading. -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#323942" BorderBrush="#46515E" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedAnnunciatorDevice.DeviceName}" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock Text="{Binding SelectedAnnunciatorDevice.StatusText}" FontSize="10.4" Foreground="#9EABB9" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="ACK IED" Click="AcknowledgeAllAlarms_Click"
                                                        Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="10"
                                                        IsEnabled="{Binding SelectedAnnunciatorDevice.HasUnacknowledged}"
                                                        ToolTip="Acknowledge all unacknowledged alarm occurrences for the selected IED only."/>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer x:Name="AnnunciatorAlarmScroller" Grid.Row="2"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                      PanningMode="HorizontalOnly" CanContentScroll="False">
                                            <ItemsControl ItemsSource="{Binding SelectedAnnunciatorDevice.Alarms}"
                                                          Height="{Binding ViewportHeight, ElementName=AnnunciatorAlarmScroller}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="250" Height="64" Margin="4,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Ellipse Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     Stroke="#F8FAFC" StrokeThickness="1.5" Opacity="{Binding LampOpacity}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#68727E"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ActiveUnacknowledged"><Setter Property="Fill" Value="#EF233C"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ActiveAcknowledged"><Setter Property="Fill" Value="#F97316"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ReturnedUnacknowledged"><Setter Property="Fill" Value="#F6C344"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>

                                                            <Border Grid.Column="1" CornerRadius="7" Padding="9,5" BorderThickness="1.4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#F7F9FC"/>
                                                                        <Setter Property="BorderBrush" Value="#C7D0DB"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ActiveUnacknowledged">
                                                                                <Setter Property="Background" Value="#FFE8EA"/>
                                                                                <Setter Property="BorderBrush" Value="#EF233C"/>
                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ActiveAcknowledged">
                                                                                <Setter Property="Background" Value="#FFF0DE"/>
                                                                                <Setter Property="BorderBrush" Value="#F97316"/>
                                                                                <Setter Property="BorderThickness" Value="1.8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding VisualState}" Value="ReturnedUnacknowledged">
                                                                                <Setter Property="Background" Value="#FFF6CF"/>
                                                                                <Setter Property="BorderBrush" Value="#E6A700"/>
                                                                                <Setter Property="BorderThickness" Value="1.8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.ToolTip>
                                                                    <StackPanel MaxWidth="430">
                                                                        <TextBlock Text="{Binding SignalName}" FontWeight="Bold" Margin="0,0,0,5"/>
                                                                        <TextBlock Text="{Binding DeviceName, StringFormat=IED: {0}}"/>
                                                                        <TextBlock Text="{Binding IecReference, StringFormat=IEC: {0}}" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding LastEventTimestamp, StringFormat=Last SOE: {0}}"/>
                                                                        <TextBlock Text="{Binding Quality, StringFormat=Quality: {0}}"/>
                                                                        <TextBlock Text="{Binding ActivationCountText}"/>
                                                                    </StackPanel>
                                                                </Border.ToolTip>
                                                                <Grid>
                                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding SignalName}" FontSize="11.6" FontWeight="SemiBold" Foreground="#26313F"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,5,0"/>
                                                                    <Border Grid.Column="1" CornerRadius="6" Padding="5,1" BorderThickness="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Setter Property="Background" Value="#ECEFF3"/>
                                                                                <Setter Property="BorderBrush" Value="#CCD4DE"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding VisualState}" Value="ActiveUnacknowledged"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#FFD7DC"/><Setter Property="BorderBrush" Value="#EF9AA5"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding VisualState}" Value="ActiveAcknowledged"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#FFE4CB"/><Setter Property="BorderBrush" Value="#F2A064"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding VisualState}" Value="ReturnedUnacknowledged"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#FFEDB2"/><Setter Property="BorderBrush" Value="#DDB44B"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding CompactStateText}" FontSize="9.2" FontWeight="Bold" Foreground="#5B4750"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1" Text="{Binding CurrentValue}" FontSize="18" FontWeight="Bold" Foreground="#111827"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentValue}"/>
                                                                    <Button Grid.Row="1" Grid.Column="1" Content="ACK" Tag="{Binding}" Click="AcknowledgeAlarm_Click"
                                                                            Padding="7,2" Margin="7,0,0,0" FontSize="9.4" MinHeight="22" VerticalAlignment="Center">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanAcknowledge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- SCL / DISCOVERY-AWARE GOOSE SUBSCRIBER -->
            <TabItem Header="GOOSE Subscriber">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*" MinHeight="260"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource WorkspaceCard}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,8,0"/>
                                    <TextBlock Text="GOOSE Subscriber" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" Background="#EEF4FF" BorderBrush="#C9D9F1" BorderThickness="1" CornerRadius="8" Padding="6,2"
                                            ToolTip="Read-only IEC 61850-8-1 Ethernet capture">
                                        <TextBlock Text="READ ONLY" FontSize="8.7" FontWeight="Bold" Foreground="#45648E"/>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource CommandOpenButton}" Click="StartGooseSubscriber_Click"
