<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Locally scoped, high-contrast task-dialog tokens. The main workspace,
         reporting UI and protocol flows keep their original global styles. -->
    <SolidColorBrush x:Key="TaskDialogCanvas" Color="{DynamicResource CoolCanvasColor}"/>
    <SolidColorBrush x:Key="TaskDialogCard" Color="{DynamicResource CoolRaisedColor}"/>
    <SolidColorBrush x:Key="TaskDialogInk" Color="{DynamicResource InkColor}"/>
    <SolidColorBrush x:Key="TaskDialogMuted" Color="{DynamicResource MutedColor}"/>
    <SolidColorBrush x:Key="TaskDialogBorder" Color="{DynamicResource CoolBorderColor}"/>
    <SolidColorBrush x:Key="TaskDialogHintSurface" Color="{DynamicResource CoolAlternateColor}"/>
    <SolidColorBrush x:Key="TaskDialogHintBorder" Color="{DynamicResource CoolBorderColor}"/>

    <Style x:Key="TaskDialogHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TaskDialogInk}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TaskDialogSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TaskDialogMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="TaskDialogSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TaskDialogMuted}"/>
    </Style>
    <Style x:Key="TaskDialogFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TaskDialogInk}"/>
    </Style>
    <Style x:Key="TaskDialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TaskDialogCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskDialogBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <!-- A standalone merged dictionary must not resolve BasedOn to App.xaml
         while it is being constructed: the global PrimaryButton/SoftButton
         styles are outside this dictionary's StaticResource parse scope. -->
    <Style x:Key="TaskDialogButtonBase" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource TaskDialogCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TaskDialogInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskDialogBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TaskDialogPrimaryAction" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TaskDialogButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="15,12"/>
    </Style>
    <Style x:Key="TaskDialogSecondaryAction" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TaskDialogButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PanelSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CoolDivider}"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="15,12"/>
    </Style>
    <Style x:Key="TaskDialogFooterButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TaskDialogButtonBase}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="MinWidth" Value="102"/>
    </Style>
    <Style x:Key="TaskDialogSubmitAction" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TaskDialogPrimaryAction}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="MinWidth" Value="174"/>
        <Setter Property="Padding" Value="13,8"/>
    </Style>
    <Style x:Key="TaskDialogError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#B42318"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
