<Application x:Class="ArIED61850Tester.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Shared operator process badge: one color/token contract for every workspace. -->
        <DataTemplate x:Key="ProcessValueBadgeTemplate">
            <Border x:Name="ProcessValueBadge"
                    CornerRadius="9" Padding="6,3" MinWidth="62"
                    HorizontalAlignment="Left"
                    Background="#F6F8FB" BorderBrush="#DCE3EC" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ProcessValueKindBadge"
                            MinWidth="20" Height="17" CornerRadius="5" Padding="3,0"
                            Margin="0,0,6,0" Visibility="Collapsed"
                            Background="#EEF2F6" BorderBrush="#D6DEE8" BorderThickness="1"
                            ToolTip="{Binding IecDataType}">
                        <TextBlock x:Name="ProcessValueKindText"
                                   Text="{Binding ValueTypeToken}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="8.2" FontWeight="Bold" Foreground="#65758A"/>
                    </Border>
                    <TextBlock x:Name="ProcessValueText"
                               Text="{Binding DisplayValue}" ToolTip="{Binding DisplayValue}"
                               FontSize="11.8" FontWeight="SemiBold" Foreground="#344054"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Type markers are metadata-only: F/I/U/B/E/DP come from the declared
                     IEC/MMS data type. No value-shape or name heuristic creates a badge. -->
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="F">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#EEF4F8"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#CCD9E3"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#536D7C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="I">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#EEF7F3"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#C9DED5"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#4E7567"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="U">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#F1F7F0"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#D2E1CE"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#607B58"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="E">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#F5F3F8"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#DDD7E7"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#6C6480"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="B">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#F3F0FF"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#D8D2F5"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#6557B5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueTypeToken}" Value="DP">
                    <Setter TargetName="ProcessValueKindBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#EEF7FC"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#C6DFEC"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#347795"/>
                </DataTrigger>

                <!-- Process state changes tone only; it never changes the type token. -->
                <DataTrigger Binding="{Binding ValueVisualKind}" Value="BooleanTrue">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#F1EFFF"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#D8D2F5"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#5A4DA7"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#7567D8"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#7567D8"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding ValueVisualKind}" Value="BooleanFalse">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#F8F7FC"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#E2DFED"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#6C657D"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="Transparent"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#978DAA"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#6F6681"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding ValueVisualKind}" Value="PositionOpen">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#ECF8FF"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#B9E2F4"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#1F6F8F"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="Transparent"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#3B9FC5"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="#247A9B"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding ValueVisualKind}" Value="PositionClose">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#EAF4FF"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#B8D8F5"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#245F9E"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#2F80ED"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#2F80ED"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding ValueVisualKind}" Value="PositionIntermediate">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#FFF8E6"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#F2D28A"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#946200"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#F59E0B"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#F59E0B"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding ValueVisualKind}" Value="PositionBad">
                    <Setter TargetName="ProcessValueBadge" Property="Background" Value="#FFF2E8"/>
                    <Setter TargetName="ProcessValueBadge" Property="BorderBrush" Value="#F3BE91"/>
                    <Setter TargetName="ProcessValueText" Property="Foreground" Value="#A14B0A"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="Background" Value="#E8791B"/>
                    <Setter TargetName="ProcessValueKindBadge" Property="BorderBrush" Value="#E8791B"/>
                    <Setter TargetName="ProcessValueKindText" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- ARSAS typography contract: static Inter faces are bundled as WPF Resource items.
             Static faces are intentional because WPF does not provide reliable variable-font
             axis selection. Ideal metrics + ClearType keep compact engineering text smooth. -->
        <FontFamily x:Key="AppFontFamily">./Assets/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="AppCodeFontFamily">Cascadia Mono, Consolas</FontFamily>

        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>
        <Color x:Key="InkColor">#111827</Color>
        <Color x:Key="MutedColor">#667085</Color>
        <Color x:Key="AccentColor">#2563EB</Color>
        <Color x:Key="AccentDeepColor">#1D4ED8</Color>
        <Color x:Key="SoftBlueColor">#EAF1FF</Color>
        <Color x:Key="BgColor">#EEF3F9</Color>
        <Color x:Key="LineColor">#DDE5F0</Color>
        <!-- P2 semantic theme tokens: one source of truth for compact engineering surfaces and states. -->
        <Color x:Key="SurfaceColor">#F8FAFD</Color>
        <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
        <Color x:Key="BorderSubtleColor">#DDE5F0</Color>
        <Color x:Key="BorderStrongColor">#B9C8DC</Color>
        <Color x:Key="SuccessColor">#15803D</Color>
        <Color x:Key="DangerColor">#DC2626</Color>
        <Color x:Key="WarningColor">#D97706</Color>

        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}"/>
        <SolidColorBrush x:Key="SoftBlue" Color="{StaticResource SoftBlueColor}"/>
        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
        <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{StaticResource SurfaceElevatedColor}"/>
        <SolidColorBrush x:Key="RowHover" Color="#F4F8FF"/>
        <SolidColorBrush x:Key="RowSelected" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="RowSelectedBorder" Color="#C7DAFF"/>

        <!-- Premium surface hierarchy. Gradients remain subtle so dense engineering data stays readable. -->
        <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8EEF7" Offset="0"/>
            <GradientStop Color="#F3F7FC" Offset="0.52"/>
            <GradientStop Color="#EAF1F9" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PremiumSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F7FAFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PremiumSurfaceHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#EEF5FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PremiumSurfaceSelected" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FBFF" Offset="0"/>
            <GradientStop Color="#E6F0FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SoftButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFF" Offset="0"/>
            <GradientStop Color="#EAF1FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IedCardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F5F9FF" Offset="0.68"/>
            <GradientStop Color="#EEF4FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IedCardHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E5F0FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IedCardSelected" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FBFF" Offset="0"/>
            <GradientStop Color="#D5E6FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IedCardConnected" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0FBF5" Offset="0.68"/>
            <GradientStop Color="#DDF5E8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IedCardConnectedSelected" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FFFB" Offset="0"/>
            <GradientStop Color="#D9F2E5" Offset="0.55"/>
            <GradientStop Color="#DCEBFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CommandPanelSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F4F8FE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CommandHeaderSurface" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EDF4FF" Offset="0"/>
            <GradientStop Color="#F7FAFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CommandOpenGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A9A62" Offset="0"/>
            <GradientStop Color="#087247" Offset="0.55"/>
            <GradientStop Color="#034B2E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CommandCloseGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EE5151" Offset="0"/>
            <GradientStop Color="#B6252D" Offset="0.55"/>
            <GradientStop Color="#75141D" Offset="1"/>
        </LinearGradientBrush>

        <!-- Reusable protection-relay fascia for IED cards. The artwork follows
             the square panel-mount form, LCD, LED banks and cyan navigation keys
             of a feeder relay while the state rail remains data-driven. -->
        <ControlTemplate x:Key="IedRelayFrontPanelTemplate" TargetType="{x:Type Control}">
            <Grid Width="50" Height="50" SnapsToDevicePixels="True">
                <Border CornerRadius="2.4" ClipToBounds="True" Background="#F5F7FA">
                    <Image x:Name="RelayFasciaArtwork"
                           Source="Assets/ied-protection-relay-fascia.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="RelayStateRail" Height="2.2" Margin="5,0,5,2.8"
                        VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}"
                        CornerRadius="1.1" Opacity="0.82"/>
            </Grid>
        </ControlTemplate>

