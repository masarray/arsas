root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,xml,props,targets,sln}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,html,css,js,py}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 4
