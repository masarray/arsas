<Window x:Class="ArIED61850Tester.IpConnectWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add IEC 61850 IED" Width="510" MinWidth="480" MaxHeight="460"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource TaskDialogCanvas}"
        FontFamily="{DynamicResource AppFontFamily}" Icon="Assets/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/IedTaskDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Dialog-local sizing: same Inter family and colors as ARSAS,
                 without changing shared styles or other task dialogs. -->
            <Style x:Key="SmartIpOctet" TargetType="{x:Type TextBox}">
                <Setter Property="Width" Value="43"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MaxLength" Value="3"/>
                <Setter Property="Padding" Value="2,3"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TaskDialogInk}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
                <EventSetter Event="PreviewTextInput" Handler="Octet_PreviewTextInput"/>
                <EventSetter Event="PreviewKeyDown" Handler="Octet_PreviewKeyDown"/>
                <EventSetter Event="TextChanged" Handler="Octet_TextChanged"/>
            </Style>
            <Style x:Key="SmartIpDot" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TaskDialogMuted}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style x:Key="SmartIpHistoryButton" TargetType="{x:Type Button}">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="HistoryChrome" Background="{TemplateBinding Background}"
                                    CornerRadius="0,7,7,0">
                                <Path Data="M 2,5 L 7,10 L 12,5" Width="14" Height="14"
                                      Stretch="Uniform" Stroke="{StaticResource TaskDialogMuted}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HistoryChrome" Property="Background" Value="#EAF2FF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HistoryChrome" Property="Background" Value="#EAF2FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HistoryChrome" Property="Background" Value="#DCEAFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Add IEC 61850 IED" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TaskDialogInk}"/>
                <TextBlock Text="Enter the device IP address to connect."
                           Margin="0,4,0,0" FontSize="11.5"
                           Foreground="{StaticResource TaskDialogMuted}"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,13"
                    Background="{StaticResource TaskDialogCard}"
                    BorderBrush="{StaticResource TaskDialogBorder}" BorderThickness="1"
                    CornerRadius="11">
                <StackPanel>
                    <TextBlock Text="IP Address" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TaskDialogInk}" Margin="0,0,0,7"/>

                    <!-- One compact visual input; four keyboard-friendly octets
                         deliberately share one surrounding field. -->
                    <Grid>
                        <Border x:Name="IpEditorHost" Height="38" CornerRadius="8"
                                BorderThickness="1" Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource TaskDialogBorder}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#9CB9E4"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="OctetEditor" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="Octet1Box" Style="{StaticResource SmartIpOctet}"
                                             AutomationProperties.Name="IP address, group 1"/>
                                    <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                    <TextBox x:Name="Octet2Box" Style="{StaticResource SmartIpOctet}"
                                             AutomationProperties.Name="IP address, group 2"/>
                                    <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                    <TextBox x:Name="Octet3Box" Style="{StaticResource SmartIpOctet}"
                                             AutomationProperties.Name="IP address, group 3"/>
                                    <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                    <TextBox x:Name="Octet4Box" Style="{StaticResource SmartIpOctet}"
                                             AutomationProperties.Name="IP address, group 4"/>
                                </StackPanel>
                                <Button x:Name="HistoryButton" Grid.Column="1"
                                        Style="{StaticResource SmartIpHistoryButton}"
                                        ToolTip="Choose a recently entered address"
                                        AutomationProperties.Name="Recent IP addresses"
                                        Click="HistoryButton_Click"/>
                            </Grid>
                        </Border>

                        <TextBox x:Name="RawIpBox" Height="38" Padding="10,6"
                                 VerticalContentAlignment="Center" Visibility="Collapsed"
                                 Foreground="{StaticResource TaskDialogInk}"
                                 Background="{StaticResource TaskDialogCard}"
                                 BorderBrush="{StaticResource TaskDialogBorder}"
                                 FontSize="12.5"
                                 Text="{Binding RelayIpAddress, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Enter an IP address manually"
                                 AutomationProperties.Name="Manual IP address"/>
                    </Grid>

                    <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=IpEditorHost}"
                           Placement="Bottom" VerticalOffset="3" AllowsTransparency="True"
                           StaysOpen="False" PopupAnimation="Fade">
                        <Border Width="398" MaxHeight="230" CornerRadius="9" Background="White"
                                BorderThickness="1" BorderBrush="{StaticResource TaskDialogBorder}"
                                Padding="9" SnapsToDevicePixels="True">
                            <StackPanel>
                                <TextBlock Text="Recent addresses" Margin="5,0,0,6"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TaskDialogMuted}"/>
                                <TextBox x:Name="HistorySearchBox" Height="30" Padding="8,4"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         VerticalContentAlignment="Center" FontSize="11.5"
                                         Background="#F7FAFD"
                                         BorderBrush="{StaticResource TaskDialogBorder}"
                                         ToolTip="Type to search saved addresses"
                                         AutomationProperties.Name="Search saved addresses"
                                         TextChanged="HistorySearchBox_TextChanged"
                                         PreviewKeyDown="HistorySearchBox_PreviewKeyDown"/>
                                <ListBox x:Name="HistoryListBox" MaxHeight="154" Margin="0,4,0,0"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         FontSize="11.5" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseLeftButtonUp="HistoryListBox_MouseLeftButtonUp"
                                         PreviewKeyDown="HistoryListBox_PreviewKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding IpAddress}" FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TaskDialogInk}"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                           Foreground="{StaticResource TaskDialogMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="HistoryEmptyText" Margin="6,7,0,2"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           Text="No matching addresses" Visibility="Collapsed"
                                           Style="{StaticResource TaskDialogSubtitle}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock x:Name="AddressHintText" Text="Example: 192.168.1.10"
                               FontSize="11" Margin="1,6,0,0"
                               Foreground="{StaticResource TaskDialogMuted}"/>

                    <!-- Rare settings remain available, without introducing
                         IEC 61850 jargon in the primary connection path. -->
                    <Expander x:Name="MoreOptionsExpander" Margin="0,10,0,0"
                              AutomationProperties.Name="More connection options">
                        <Expander.Header>
                            <TextBlock Text="More options" FontSize="11.5"
                                       Foreground="{DynamicResource Accent}"/>
                        </Expander.Header>
                        <StackPanel Margin="17,7,0,1">
                            <TextBlock Text="Port" FontSize="11"
                                       Foreground="{StaticResource TaskDialogMuted}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="MmsPortBox" Width="92" Height="32"
                                     HorizontalAlignment="Left" Padding="9,4"
                                     FontSize="12" VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TaskDialogInk}"
                                     BorderBrush="{StaticResource TaskDialogBorder}"
                                     ToolTip="Default MMS TCP port: 102"
                                     Text="{Binding MmsPortText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox x:Name="ManualAddressCheck" Margin="0,10,0,0"
                                      Content="Enter address manually" FontSize="11"
                                      Foreground="{StaticResource TaskDialogMuted}"
                                      Click="ManualAddressCheck_Click"/>
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="WizardStatusText" Margin="0,9,0,0"
                               Style="{StaticResource TaskDialogError}"
                               AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{StaticResource TaskDialogFooterButton}"
                        MinHeight="34" MinWidth="84" Padding="12,6"
                        Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Connect" Style="{StaticResource TaskDialogSubmitAction}"
                        MinWidth="112" MinHeight="34" Padding="14,6"
                        IsDefault="True" Click="Connect_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
