<Window x:Class="ArIED61850Tester.IpConnectWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add IEC 61850 IED" Width="700" MinWidth="640" MaxHeight="660"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource TaskDialogCanvas}"
        FontFamily="{DynamicResource AppFontFamily}" Icon="Assets/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/IedTaskDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SmartIpOctet" TargetType="{x:Type TextBox}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="MaxLength" Value="3"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="5,5"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TaskDialogInk}"/>
                <Setter Property="CaretBrush" Value="#2563EB"/>
                <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
                <EventSetter Event="PreviewTextInput" Handler="Octet_PreviewTextInput"/>
                <EventSetter Event="PreviewKeyDown" Handler="Octet_PreviewKeyDown"/>
                <EventSetter Event="TextChanged" Handler="Octet_TextChanged"/>
            </Style>
            <Style x:Key="SmartIpDot" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TaskDialogMuted}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Add IEC 61850 IED" Style="{StaticResource TaskDialogHeading}"/>
                <TextBlock Margin="0,5,0,0" Style="{StaticResource TaskDialogSubtitle}"
                           Text="Enter a device address to discover its IEC 61850 data model."/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource TaskDialogCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IED IP address" Style="{StaticResource TaskDialogFieldLabel}" Margin="0,0,0,7"/>
                            <Border x:Name="IpEditorHost" Height="44" CornerRadius="10"
                                    BorderThickness="1.5"
                                    Background="{StaticResource TaskDialogCard}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource TaskDialogBorder}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#86AEEF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="OctetEditor" Grid.Column="0" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBox x:Name="Octet1Box" Style="{StaticResource SmartIpOctet}"
                                                 AutomationProperties.Name="IPv4 octet 1, 0 through 255"/>
                                        <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                        <TextBox x:Name="Octet2Box" Style="{StaticResource SmartIpOctet}"
                                                 AutomationProperties.Name="IPv4 octet 2, 0 through 255"/>
                                        <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                        <TextBox x:Name="Octet3Box" Style="{StaticResource SmartIpOctet}"
                                                 AutomationProperties.Name="IPv4 octet 3, 0 through 255"/>
                                        <TextBlock Text="." Style="{StaticResource SmartIpDot}"/>
                                        <TextBox x:Name="Octet4Box" Style="{StaticResource SmartIpOctet}"
                                                 AutomationProperties.Name="IPv4 octet 4, 0 through 255"/>
                                    </StackPanel>
                                    <Button x:Name="HistoryButton" Grid.Column="1" Content="⌄"
                                            FontSize="18" ToolTip="Search previously entered and connected IED addresses"
                                            AutomationProperties.Name="Show address history"
                                            Click="HistoryButton_Click"
                                            Style="{StaticResource TaskDialogButtonBase}"
                                            Padding="7,0" BorderThickness="0,0,0,0" Background="Transparent"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=IpEditorHost}"
                                   Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                                   StaysOpen="False" PopupAnimation="Fade">
                                <Border Width="432" MaxHeight="270" CornerRadius="12" Background="White"
                                        BorderThickness="1" BorderBrush="{StaticResource TaskDialogBorder}"
                                        Padding="10" SnapsToDevicePixels="True">
                                    <StackPanel>
                                        <TextBox x:Name="HistorySearchBox" Height="34" Padding="9,5"
                                                 VerticalContentAlignment="Center" Background="#F5F8FD"
                                                 BorderBrush="{StaticResource TaskDialogBorder}"
                                                 ToolTip="Filter by IP or saved IED name"
                                                 AutomationProperties.Name="Search IED address history"
                                                 TextChanged="HistorySearchBox_TextChanged"
                                                 PreviewKeyDown="HistorySearchBox_PreviewKeyDown"/>
                                        <ListBox x:Name="HistoryListBox" MaxHeight="202" Margin="0,6,0,0"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseLeftButtonUp="HistoryListBox_MouseLeftButtonUp"
                                                 PreviewKeyDown="HistoryListBox_PreviewKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="5,4">
                                                        <TextBlock Text="{Binding IpAddress}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TaskDialogInk}"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{StaticResource TaskDialogMuted}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="HistoryEmptyText" Margin="8,8,0,5"
                                                   Text="No matching saved addresses"
                                                   Visibility="Collapsed" Style="{StaticResource TaskDialogSubtitle}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBox x:Name="RawIpBox" Height="44" Margin="0,0,0,0" Padding="12,7"
                                     VerticalContentAlignment="Center" Visibility="Collapsed"
                                     Foreground="{StaticResource TaskDialogInk}"
                                     BorderBrush="{StaticResource TaskDialogBorder}"
                                     Text="{Binding RelayIpAddress, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Advanced input: IPv4 or IPv6 literal"
                                     AutomationProperties.Name="Advanced IPv4 or IPv6 address"/>
                            <CheckBox x:Name="ManualAddressCheck" Margin="1,10,0,0"
                                      Content="Advanced: IPv6 / manual address" FontSize="11.5"
                                      Foreground="{StaticResource TaskDialogMuted}"
                                      Click="ManualAddressCheck_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MMS port" Style="{StaticResource TaskDialogFieldLabel}" Margin="0,0,0,7"/>
                            <TextBox Height="44" VerticalContentAlignment="Center" Padding="9,5"
                                     Foreground="{StaticResource TaskDialogInk}" Background="{StaticResource TaskDialogCard}"
                                     BorderBrush="{StaticResource TaskDialogBorder}"
                                     ToolTip="IEC 61850 MMS normally uses TCP port 102"
                                     Text="{Binding MmsPortText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AddressHintText" Margin="2,8,0,0"
                               Style="{StaticResource TaskDialogSubtitle}"
                               Text="Enter four IPv4 numbers (0–255). Use dot, arrows, Tab or paste a complete address."/>
                    <Border Margin="0,14,0,0" Background="{StaticResource TaskDialogHintSurface}"
                            BorderBrush="{StaticResource TaskDialogHintBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Smart discovery" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TaskDialogInk}"/>
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource TaskDialogSubtitle}"
                                       Text="Reads the live DataSets and RCBs, and restores saved signal choices."/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WizardStatusText" Margin="0,12,0,0"
                               Style="{StaticResource TaskDialogError}"
                               AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource TaskDialogFooterButton}"
                        Click="Cancel_Click" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="Connect &amp; Discover" Style="{StaticResource TaskDialogSubmitAction}"
                        MinWidth="174" MinHeight="38" IsDefault="True" Click="Connect_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
