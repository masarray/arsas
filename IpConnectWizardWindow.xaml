<Window x:Class="ArIED61850Tester.IpConnectWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add IEC 61850 IED" Width="700" MinWidth="640" MaxHeight="620"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource TaskDialogCanvas}"
        FontFamily="{DynamicResource AppFontFamily}" Icon="Assets/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/IedTaskDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Add IEC 61850 IED" Style="{StaticResource TaskDialogHeading}"/>
                <TextBlock Margin="0,5,0,0" Style="{StaticResource TaskDialogSubtitle}"
                           Text="Enter the IED IP address to connect and discover available signals."/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource TaskDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="128"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="IED IP Address" Style="{StaticResource TaskDialogFieldLabel}"
                                   Margin="0,0,0,7"/>
                        <ComboBox x:Name="RelayIpBox" Height="40" MinWidth="0"
                                  Foreground="{StaticResource TaskDialogInk}"
                                  Background="{StaticResource TaskDialogCard}"
                                  BorderBrush="{StaticResource TaskDialogBorder}"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  ToolTip="Enter a new IP address or choose a previously saved address"
                                  ItemsSource="{Binding RecentRelayIps, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding RelayIpAddress, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="MMS Port" Style="{StaticResource TaskDialogFieldLabel}"
                                   Margin="0,0,0,7"/>
                        <TextBox Height="40" VerticalContentAlignment="Center"
                                 Padding="9,5" Foreground="{StaticResource TaskDialogInk}"
                                 Background="{StaticResource TaskDialogCard}"
                                 BorderBrush="{StaticResource TaskDialogBorder}"
                                 ToolTip="IEC 61850 MMS normally uses TCP port 102"
                                 Text="{Binding MmsPortText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0"
                            Background="{StaticResource TaskDialogHintSurface}"
                            BorderBrush="{StaticResource TaskDialogHintBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12,11">
                        <StackPanel>
                            <TextBlock Text="Smart discovery" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TaskDialogInk}"/>
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource TaskDialogSubtitle}"
                                       Text="Reads the live DataSets and RCBs, and restores saved signal choices."/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="WizardStatusText" Grid.Row="2" Grid.ColumnSpan="3"
                               Margin="0,12,0,0" Style="{StaticResource TaskDialogError}"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource TaskDialogFooterButton}"
                        Click="Cancel_Click" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="Connect &amp; Discover" Style="{StaticResource TaskDialogSubmitAction}"
                        MinWidth="174" MinHeight="38" IsDefault="True" Click="Connect_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
