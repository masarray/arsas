<Window x:Class="ArIED61850Tester.SclSignalSelectionModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="760" MinWidth="760" MaxWidth="760"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Bg}"
        FontFamily="Aptos, Segoe UI Variable Text, Segoe UI, Calibri"
        Icon="Assets/app-icon.ico">
    <Grid Margin="22,20,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ContextHeading}" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"/>
                <TextBlock Margin="0,4,0,0" FontSize="12.3" Foreground="{StaticResource Muted}"
                           Text="{Binding ContextSubtitle}"/>
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Background="#E8F1FF"
                    BorderBrush="#C8DAF8" BorderThickness="1" CornerRadius="11" Padding="11,6">
                <TextBlock Text="{Binding ImportScopeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#315D9D"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Background="#FFFFFF" BorderBrush="#D8E2EF"
                BorderThickness="1" CornerRadius="14" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="MONITORING" FontSize="10.5" FontWeight="SemiBold" Foreground="#667085"/>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Padding="14,11"
                            Click="MonitorStaticDataSet_Click" ToolTip="Select authoritative static DataSet members and start online monitoring">
                        <StackPanel>
                            <TextBlock Text="Static DataSet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select + monitor" FontSize="10.5" Opacity="0.82" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SoftButton}" Padding="14,11"
                            Click="MonitorManual_Click" ToolTip="Choose exact ST, MX and control points, then start monitoring">
                        <StackPanel>
                            <TextBlock Text="Select Signals" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manual + monitor" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.2"
                           Foreground="{StaticResource Muted}"
                           Text="Signal selection is shared with FAT, but monitoring starts only after you choose one of these monitoring actions."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="#FFFFFF" BorderBrush="#D8E2EF"
                BorderThickness="1" CornerRadius="14" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ENGINEERING &amp; FILES" FontSize="10.5" FontWeight="SemiBold" Foreground="#667085"/>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SoftButton}" Padding="14,11"
                            Click="RcbEngineering_Click" ToolTip="Review SCL ReportControl/DataSet configuration without starting monitoring">
                        <StackPanel>
                            <TextBlock Text="RCB Engineering" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Offline-first" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SoftButton}" Padding="14,11"
                            Click="DownloadComtrade_Click" ToolTip="Open fault-record download using only the file-transfer workflow">
                        <StackPanel>
                            <TextBlock Text="Download COMTRADE" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="File service only" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.2"
                           Foreground="{StaticResource Muted}"
                           Text="RCB engineering does not start online monitoring. COMTRADE uses a task-scoped MMS file-transfer connection and leaves Live Monitor ownership unchanged."/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="11.3" Foreground="#667085"
                       Text="Need only the model? Keep this IED in its current offline/engineering state."/>
            <Button Grid.Column="1" Style="{StaticResource SoftButton}" MinWidth="124" Padding="13,8"
                    Click="BrowseOffline_Click" IsCancel="True" Content="Browse Offline"/>
        </Grid>
    </Grid>
</Window>
