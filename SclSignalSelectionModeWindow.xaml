<Window x:Class="ArIED61850Tester.SclSignalSelectionModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="760" MinWidth="700" MaxHeight="680"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource TaskDialogCanvas}"
        FontFamily="{DynamicResource AppFontFamily}" Icon="Assets/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/IedTaskDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Open SCL mode retains the "Workspace opened offline" heading supplied
         by ContextHeading in code-behind. Card-scoped mode uses IED Actions.
         Both keep the same explicit monitoring vs offline task authority. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0">
        <Grid Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource TaskDialogHeading}" Text="{Binding ContextHeading}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource TaskDialogSubtitle}"
                               Text="{Binding ContextSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource TaskDialogHintSurface}"
                        BorderBrush="{StaticResource TaskDialogHintBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="11,6">
                    <TextBlock Text="{Binding ImportScopeText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#284F89" MaxWidth="210" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ImportScopeText}"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource TaskDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="GET STARTED" Style="{StaticResource TaskDialogSectionTitle}"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StaticDataSetActionButton" Grid.Column="0" Style="{StaticResource TaskDialogPrimaryAction}"
                                IsEnabled="{Binding CanUseStaticDataSet}" Click="MonitorStaticDataSet_Click"
                                ToolTip="Use configured static DataSet members with report-backed monitoring">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Static DataSet" Foreground="#FFFFFF" FontWeight="SemiBold"
                                           FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StaticDataSetAvailabilityText}" FontSize="11"
                                           Foreground="#FFFFFF" Margin="0,3,0,0" TextAlignment="Center"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BrowseIedActionButton" Grid.Column="2" Style="{StaticResource TaskDialogPrimaryAction}"
                                Click="BrowseIed_Click"
                                ToolTip="Explore IED model, DataSets and RCB. Explicit Read fetches selected values, never enabling RCB or polling.">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Browse IED" FontWeight="SemiBold" FontSize="13"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Explore model and live values" FontSize="11"
                                           Foreground="#FFFFFF" Margin="0,3,0,0" TextAlignment="Center"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ManualSignalsActionButton" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                Style="{StaticResource TaskDialogSecondaryAction}"
                                Click="MonitorManual_Click"
                                ToolTip="Select exact ST/MX signals and controls, then start live monitoring">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Select Signals" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TaskDialogInk}" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  Choose signals manually" FontSize="11"
                                           Foreground="{StaticResource TaskDialogMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource TaskDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ENGINEERING &amp; FILES" Style="{StaticResource TaskDialogSectionTitle}"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource TaskDialogSecondaryAction}"
                                Click="RcbEngineering_Click"
                                ToolTip="Review SCL DataSets and report control configuration; does not start monitoring">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="RCB Engineering" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TaskDialogInk}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Review report settings" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{StaticResource TaskDialogMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource TaskDialogSecondaryAction}"
                                Click="DownloadComtrade_Click"
                                ToolTip="Open the separate MMS file-transfer workflow without starting the live monitor">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Download COMTRADE" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TaskDialogInk}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Download disturbance files" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{StaticResource TaskDialogMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                           Style="{StaticResource TaskDialogSubtitle}"
                           Text="Inspect model locally; use Read for values when connected."/>
                <Button Grid.Column="1" Style="{StaticResource TaskDialogFooterButton}"
                        Click="BrowseOffline_Click" IsCancel="True" Content="Close"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
