<Window x:Class="ArIED61850Tester.BrowserRcbPurgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRCB PurgeBuf · Manual MMS Write"
        Width="520" Height="328" MinWidth="520" MinHeight="328"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Purge buffered report history" FontSize="15"
                   FontWeight="SemiBold" Foreground="#223148"/>
        <TextBlock Grid.Row="1" x:Name="RcbReferenceText" Margin="0,8,0,12"
                   FontSize="11.5" TextWrapping="Wrap" Foreground="#415269"/>
        <Border Grid.Row="2" Background="#FFF5E6" BorderBrush="#F1D4A2"
                BorderThickness="1" Padding="10" CornerRadius="5">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#75501C"
                       Text="This operation permanently discards pending BRCB history on the IED. Use only in an authorized test. ARSAS never runs this operation automatically."/>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock FontSize="11.5" Foreground="#415269"
                       Text="Type PURGE to authorize one explicit PurgeBuf = TRUE MMS Write:"/>
            <TextBox x:Name="ConfirmationBox" Margin="0,5,0,0" Height="29"
                     FontSize="12" Padding="7,3" MaxLength="5"
                     TextChanged="ConfirmationBox_TextChanged"/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,10,0,0"
                   TextWrapping="Wrap" FontSize="11.5" Foreground="#415269"
                   Text="No MMS Write sent."/>
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Cancel" Width="82" Height="30"
                    Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="PurgeButton" Content="Write PurgeBuf" Width="126" Height="30"
                    IsEnabled="False" Click="Purge_Click"/>
        </StackPanel>
    </Grid>
</Window>
